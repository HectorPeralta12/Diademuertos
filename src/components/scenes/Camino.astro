import { marigold, EDGE } from '../../scripts/marigold';

/**
 * The marigold path, from the door of the house to the altar, at night.
 *
 * A full illustration drawn in SVG (adobe house, tile roof, cantera door frame,
 * distant town, moon and stars, an altar with its marigold arch) with one light
 * source per moment: the moon at first, then the warm light from the opening
 * door, then the candles. A canvas on top carries what moves: petals that fall,
 * flip and settle along the path with their shadows, marigold heads that bloom
 * as the path passes, a small light (the soul) that follows it, and the copal
 * smoke. Everything is placed with a seeded random, so it lands the same way on
 * every visit.
 */

// Seeded random for the static scenery
function random(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = random(2026);
// A second stream for the refinements, so the original scenery keeps its exact layout
const r2 = random(1031);
const f = (n: number) => +n.toFixed(1);

// Nine marigolds: three petal arrangements in three tones (golden, orange, deep orange).
// Every flower in the scene is one of these, placed with <use>.
const MARIGOLDS = [0, 1, 2].flatMap((shape) => [0, 1, 2].map((tone) => ({ id: `cm-mg-${shape}${tone}`, layers: marigold(shape, tone) })));
type Flower = { x: number; y: number; r: number; v: string; rot: number };
const flower = (x: number, y: number, rad: number, tone: number, shape = Math.floor(r2() * 3)): Flower => ({
  x: f(x - rad),
  y: f(y - rad),
  r: f(rad * 2),
  v: `#cm-mg-${shape}${tone}`,
  rot: Math.round(r2() * 360),
});

// The path, in a 1600 × 900 field: from the door's threshold, toward the viewer, back to the altar
const PATH = 'M300 702 C 360 760 470 800 620 812 S 900 830 1030 790 S 1180 742 1300 748';

const MOON = { x: 860, y: 150, r: 46 };
const stars = Array.from({ length: 110 }, () => {
  const x = r() * 1600;
  const y = r() * 520;
  return { x: f(x), y: f(y), s: f(0.5 + r() * 1.3), d: f(2 + r() * 4), o: f(r() * -6), far: Math.hypot(x - MOON.x, y - MOON.y) > 90 };
}).filter((s) => s.far);

// Far hills with the lights of a town
const hillsFar = 'M0 600 C 160 560 300 590 420 570 S 700 520 880 556 S 1180 590 1340 548 S 1520 560 1600 556 V 720 H 0 Z';
const hillsNear = 'M0 650 C 200 630 330 660 520 640 S 860 610 1040 642 S 1360 668 1600 630 V 720 H 0 Z';
const town = Array.from({ length: 70 }, () => ({ x: f(560 + r() * 520), y: f(560 + r() * 60), s: f(0.8 + r() * 1.2), d: f(3 + r() * 5), o: f(r() * -8) }));

// Altar geometry (base at y 730, centered at x 1300)
const tiers = [
  { x: 1130, w: 340, y: 650, h: 80, top: 18 },
  { x: 1166, w: 268, y: 562, h: 70, top: 16 },
  { x: 1200, w: 200, y: 480, h: 66, top: 14 },
];

// The marigold arch: a garland of flowers along a half circle and down two posts.
// A back row of smaller, deeper flowers sits just off the line, so the edge is irregular.
const ORANGES = ['#f29a1c', '#ff9a1a', '#e8780c', '#f7a531', '#d9620b'];
const TONE_OF = [1, 1, 2, 0, 2]; // each old color, as a marigold tone
const archFront: Flower[] = [];
for (let i = 0; i <= 46; i++) {
  const a = Math.PI + (i / 46) * Math.PI;
  const s = 9 + r() * 5;
  archFront.push(flower(1300 + Math.cos(a) * 196, 470 + Math.sin(a) * 196, s * 1.12, TONE_OF[Math.floor(r() * ORANGES.length)], i % 3));
}
for (let y = 490; y < 724; y += 17) {
  for (const x of [1104, 1496]) {
    const jx = (r() - 0.5) * 5;
    const s = 8 + r() * 4;
    archFront.push(flower(x + jx, y, s * 1.15, TONE_OF[Math.floor(r() * ORANGES.length)]));
  }
}
const archBack: Flower[] = [];
for (let i = 0; i < 44; i++) {
  const a = Math.PI + ((i + 0.5) / 44) * Math.PI;
  const R = 196 + (i % 2 ? 1 : -1) * (6 + r2() * 2.5);
  archBack.push(flower(1300 + Math.cos(a) * R, 470 + Math.sin(a) * R, 8 + r2() * 2.5, 2));
}
for (let y = 498; y < 716; y += 22) {
  for (const x of [1104, 1496]) archBack.push(flower(x + (y % 44 ? 6 : -6), y, 8 + r2() * 2, 2));
}
const arch = [...archBack, ...archFront];

// Papel picado hangs from cords. Each sheet is folded over its cord at an even
// spacing along it, and tilts with the cord's slope where it hangs.
type Cord = { a: [number, number]; c: [number, number]; b: [number, number] };
const cordPath = ({ a, c, b }: Cord) => `M${a[0]} ${a[1]} Q ${c[0]} ${c[1]} ${b[0]} ${b[1]}`;
function hang(cord: Cord, colors: string[], from: number, to: number) {
  const { a, c, b } = cord;
  const at = (t: number) => [
    (1 - t) ** 2 * a[0] + 2 * (1 - t) * t * c[0] + t * t * b[0],
    (1 - t) ** 2 * a[1] + 2 * (1 - t) * t * c[1] + t * t * b[1],
  ];
  // Sample the curve to space the sheets by length, not by t
  const pts = Array.from({ length: 201 }, (_, i) => at(i / 200));
  const len = [0];
  for (let i = 1; i < pts.length; i++) len.push(len[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
  const total = len[len.length - 1];
  return colors.map((col, i) => {
    const want = (from + ((i + 0.5) / colors.length) * (to - from)) * total;
    const k = len.findIndex((l) => l >= want);
    const [x, y] = pts[k];
    const [x2, y2] = pts[Math.min(k + 1, pts.length - 1)];
    const [x1, y1] = pts[Math.max(k - 1, 0)];
    return { c: col, x: f(x), y: f(y), angle: f((Math.atan2(y2 - y1, x2 - x1) * 180) / Math.PI), i };
  });
}

// A point on the arch's center line (angle from π on the left to 2π on the right)
const onArch = (a: number): [number, number] => [f(1300 + Math.cos(a) * 196), f(470 + Math.sin(a) * 196)];

// Over the altar: a short cord tied to both shoulders of the arch
const altarCord: Cord = { a: onArch(Math.PI + 0.9), c: [1300, 346], b: onArch(2 * Math.PI - 0.9) };
const flags = hang(altarCord, ['#e8577e', '#f29a1c', '#7b2d8e', '#1f9e8a', '#ffd27a', '#e8577e', '#f29a1c'], 0.06, 0.94);

// The camera frames a slightly tighter 16:9 window of the field
const VB = { x: 60, y: 24, w: 1480, h: 832.5 };
// Layers over part of the field (the arch, the candles) only cover their own box,
// placed over the same field coordinates
function region(x: number, y: number, w: number, h: number) {
  const pc = (v: number) => `${(v * 100).toFixed(4)}%`;
  return {
    viewBox: `${x} ${y} ${w} ${h}`,
    style: `left: ${pc((x - VB.x) / VB.w)}; top: ${pc((y - VB.y) / VB.h)}; width: ${pc(w / VB.w)}; height: ${pc(h / VB.h)}`,
  };
}
const ARCH_BOX = region(1070, 240, 460, 500);
const FRONT_BOX = region(960, 180, VB.x + VB.w - 960, VB.y + VB.h - 180);

// A low stone wall behind the path, with pots and votive candles that light as the soul passes
const STONES = ['#5b4a52', '#4c3d47', '#665360', '#54434d', '#45363f'];
const wallStones: { x: number; y: number; w: number; h: number; c: string }[] = [];
for (let row = 0; row < 4; row++) {
  let x = 560 - (row % 2) * 18;
  while (x < 1090) {
    const w = 26 + r() * 30;
    wallStones.push({ x: f(x), y: 646 + row * 15, w: f(Math.min(w, 1090 - x)), h: 13, c: STONES[Math.floor(r() * STONES.length)] });
    x += w + 2;
  }
}
const votives = [640, 712, 846, 918, 1052].map((x) => ({ x, at: +(0.1 + ((x - 300) / 1000) * 0.7).toFixed(3) }));
const pots = [672, 880, 1000];

// Papel picado strung from the corner of the roof to the left shoulder of the arch
const skyCord: Cord = { a: [534, 296], c: [830, 468], b: onArch(Math.PI + 0.45) };
const skyFlags = hang(skyCord, Array.from({ length: 9 }, (_, i) => ['#e8577e', '#f29a1c', '#7b2d8e', '#1f9e8a', '#ffd27a'][i % 5]), 0.06, 0.94);

// A candle flame: a rounded base that tapers into a fine tip, and its bright core
const flame = (x: number, base: number, h: number, w: number) =>
  `M${x} ${base - h} C ${x + w * 0.3} ${base - h * 0.72} ${x + w * 1.08} ${base - h * 0.42} ${x + w} ${base - h * 0.2} C ${x + w * 0.95} ${base - h * 0.04} ${x + w * 0.5} ${base} ${x} ${base} C ${x - w * 0.5} ${base} ${x - w * 0.95} ${base - h * 0.04} ${x - w} ${base - h * 0.2} C ${x - w * 1.08} ${base - h * 0.42} ${x - w * 0.3} ${base - h * 0.72} ${x} ${base - h} Z`;

// Candles: they light from the front, outside in, up to the top tier
const candles = [
  { x: 1112, y: 744, h: 54, at: 0.8 },
  { x: 1488, y: 744, h: 54, at: 0.815 },
  { x: 1158, y: 641, h: 32, at: 0.83 },
  { x: 1442, y: 641, h: 32, at: 0.845 },
  { x: 1196, y: 553, h: 34, at: 0.86 },
  { x: 1404, y: 553, h: 34, at: 0.875 },
  { x: 1244, y: 473, h: 40, at: 0.89 },
  { x: 1356, y: 473, h: 40, at: 0.905 },
];

// Pan de muerto: four dough bones in a cross over the dome, turned 45° to us,
// so two run down the front and two fall away over the back. Each bone is a
// row of knuckles along a curve, with a knob at both ends.
const BREAD = { x: 1300, base: 548, w: 40, h: 30 };
function bone(p0: [number, number], c: [number, number], p1: [number, number], size: number) {
  const knots: { x: number; y: number; r: number }[] = [];
  const steps = 7;
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const x = (1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * c[0] + t * t * p1[0];
    const y = (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * c[1] + t * t * p1[1];
    const end = i === 0 || i === steps;
    knots.push({ x: f(x), y: f(y), r: f(size * (end ? 1.25 : i % 2 ? 0.82 : 1)) });
  }
  return knots;
}
const top: [number, number] = [BREAD.x, BREAD.base - BREAD.h + 3];
const bonesBack = [
  bone(top, [1283, 521], [1266, 530], 2.6),
  bone(top, [1317, 521], [1334, 530], 2.6),
];
const bonesFront = [
  bone(top, [1281, 526], [1275, 546], 3.3),
  bone(top, [1319, 526], [1325, 546], 3.3),
];
const sugar = Array.from({ length: 26 }, () => {
  const t = r2();
  const a = Math.PI + t * Math.PI;
  const rr = Math.sqrt(r2()) * 0.92;
  return { x: f(BREAD.x + Math.cos(a) * BREAD.w * rr), y: f(BREAD.base - 3 + Math.sin(a) * (BREAD.h - 3) * rr), s: f(0.5 + r2() * 0.6) };
});

// Flowers in the pots and vases
const sillPot = [
  [412, 504, 8.5], [428, 496, 9.5], [442, 505, 8], [420, 512, 7.5], [436, 513, 7],
].map(([x, y, s], k) => flower(x, y, s, k % 3));
const potFlowers = [672, 880, 1000].map((x, k) =>
  [[-9, 597, 7.5], [9, 596, 7.5], [0, 586, 8.5], [1, 601, 6.5]].map(([dx, y, s], j) => flower(x + dx, y, s, (j + k) % 3)),
);
const VASE = [
  [-13, 398, 8.5], [1, 387, 9.5], [13, 397, 8.5], [-6, 411, 7.5], [8, 412, 7],
];
const vases = [1214, 1386].map((x, k) => ({
  x,
  flowers: VASE.map(([dx, y, s], j) => flower(x + dx * (k ? -1 : 1), y, s, (j + k) % 3)),
}));

// Ground pebbles in perspective
const pebbles = Array.from({ length: 90 }, () => {
  const y = 720 + Math.pow(r(), 0.7) * 180;
  const k = (y - 700) / 200;
  return { x: f(r() * 1600), y: f(y), rx: f(2 + k * 6 * (0.5 + r())), ry: f(1 + k * 2.4 * (0.5 + r())), o: f(0.25 + r() * 0.35) };
});
