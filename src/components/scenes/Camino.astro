          <path d="M256 702 V 566 A 44 44 0 0 1 344 566 V 702 Z" fill="#120b10" />
          <path d="M256 702 V 566 A 44 44 0 0 1 344 566 V 702 Z" fill="url(#cm-inside)" class="lit-in" />
          <g class="leaf">
            <path d="M256 702 V 566 A 44 44 0 0 1 344 566 V 702 Z" fill="url(#cm-wood)" />
            {[278, 300, 322].map((x) => <path d={`M${x} 528 V 702`} stroke="#2a170d" stroke-width="2" />)}
            {[590, 650].map((y) => <rect x="258" y={y} width="84" height="7" fill="#2a170d" opacity="0.7" />)}
            {[268, 288, 312, 332].flatMap((x) => [594, 654].map((y) => <circle cx={x} cy={y + 3} r="2.4" fill="#c9a86a" />))}
            <circle cx="334" cy="632" r="4" fill="none" stroke="#c9a86a" stroke-width="2" />
