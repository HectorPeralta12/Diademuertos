<section class="scene camino" data-scene="camino" data-theme="noche" data-chapter="elementos" style="--len: 560">
  <div class="stage">
    <div class="world" data-world data-vb={JSON.stringify(VB)}>
      <svg class="art" viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id="cm-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#07051a" />
            <stop offset="0.55" stop-color="#160f38" />
            <stop offset="0.8" stop-color="#2c1a4c" />
            <stop offset="1" stop-color="#3d2254" />
          </linearGradient>
          <radialGradient id="cm-moon" cx="0.38" cy="0.36" r="0.7">
            <stop offset="0" stop-color="#fffaf0" />
            <stop offset="0.7" stop-color="#ece3cf" />
            <stop offset="1" stop-color="#cfc3aa" />
          </radialGradient>
          <radialGradient id="cm-moonhalo">
            <stop offset="0.3" stop-color="#cfd6ff" stop-opacity="0.22" />
            <stop offset="1" stop-color="#cfd6ff" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="cm-ground" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2a1d33" />
            <stop offset="0.35" stop-color="#1d1426" />
            <stop offset="1" stop-color="#0d0915" />
          </linearGradient>
          <linearGradient id="cm-adobe" x1="0" y1="0" x2="0.35" y2="1">
            <stop offset="0" stop-color="#b8694a" />
            <stop offset="0.5" stop-color="#93503a" />
            <stop offset="1" stop-color="#5d3226" />
          </linearGradient>
          <linearGradient id="cm-eave" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#000" stop-opacity="0.55" />
            <stop offset="1" stop-color="#000" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="cm-tile" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#7a2f1c" />
            <stop offset="0.45" stop-color="#c25a35" />
            <stop offset="1" stop-color="#6b2817" />
          </linearGradient>
          <pattern id="cm-tiles" width="26" height="40" patternUnits="userSpaceOnUse">
            <rect width="26" height="40" fill="#5a2213" />
            <rect x="1" y="0" width="24" height="40" rx="12" fill="url(#cm-tile)" />
          </pattern>
          <linearGradient id="cm-wood" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#3e2416" />
            <stop offset="0.5" stop-color="#6a3f25" />
            <stop offset="1" stop-color="#3a2114" />
          </linearGradient>
          <radialGradient id="cm-inside" cx="0.5" cy="0.75" r="0.8">
            <stop offset="0" stop-color="#fff1c9" />
            <stop offset="0.45" stop-color="#ffc56b" />
            <stop offset="1" stop-color="#d97a1f" />
          </radialGradient>
          <radialGradient id="cm-spill" cx="0.5" cy="0" r="1">
            <stop offset="0" stop-color="#ffc870" stop-opacity="0.75" />
            <stop offset="0.6" stop-color="#ff9d3a" stop-opacity="0.18" />
            <stop offset="1" stop-color="#ff9d3a" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="cm-warm">
            <stop offset="0" stop-color="#ffd27a" stop-opacity="0.75" />
            <stop offset="0.35" stop-color="#ff9d3a" stop-opacity="0.32" />
            <stop offset="1" stop-color="#ff9d3a" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="cm-night">
            <stop offset="0.35" stop-color="#0a0720" stop-opacity="0.72" />
            <stop offset="1" stop-color="#0a0720" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="cm-flame" cx="0.5" cy="0.7" r="0.6">
            <stop offset="0" stop-color="#fffbe8" />
            <stop offset="0.45" stop-color="#ffd27a" />
            <stop offset="1" stop-color="#f2781c" />
          </radialGradient>
          <radialGradient id="cm-glow">
            <stop offset="0" stop-color="#ffcf70" stop-opacity="0.85" />
            <stop offset="0.4" stop-color="#ff9d3a" stop-opacity="0.25" />
            <stop offset="1" stop-color="#ff9d3a" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="cm-wax" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#d9cdb6" />
            <stop offset="0.4" stop-color="#fbf5e8" />
            <stop offset="1" stop-color="#bfb197" />
          </linearGradient>
          <linearGradient id="cm-cloth" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#6d2a8c" />
            <stop offset="1" stop-color="#3f1656" />
          </linearGradient>
          <linearGradient id="cm-clothtop" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#d9c7a8" />
            <stop offset="1" stop-color="#b9a585" />
          </linearGradient>
          <linearGradient id="cm-clay" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#7a3a1e" />
            <stop offset="0.45" stop-color="#c06a38" />
            <stop offset="1" stop-color="#6a3018" />
          </linearGradient>
          <linearGradient id="cm-sepia" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#d9c3a0" />
            <stop offset="1" stop-color="#a88b66" />
          </linearGradient>
          <radialGradient id="cm-bread" cx="0.4" cy="0.3" r="0.8">
            <stop offset="0" stop-color="#f3c47a" />
            <stop offset="0.6" stop-color="#cf8a3c" />
            <stop offset="1" stop-color="#9a5a22" />
          </radialGradient>
          <filter id="cm-grain" x="0" y="0" width="100%" height="100%">
            <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" />
            <feColorMatrix type="saturate" values="0" />
            <feComponentTransfer>
              <feFuncA type="linear" slope="0.5" />
            </feComponentTransfer>
          </filter>
          <filter id="cm-soft" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="14" />
          </filter>
          {
            MARIGOLDS.map((m) => (
              <symbol id={m.id} viewBox="-1 -1 2 2" overflow="visible">
                {m.layers.map((l) => (
                  <path d={l.d} fill={l.fill} stroke={l.stroke} stroke-width={l.stroke ? EDGE : undefined} stroke-linejoin="round" opacity={l.opacity} />
                ))}
              </symbol>
            ))
          }
          <radialGradient id="cm-orange" cx="0.36" cy="0.32" r="0.75">
            <stop offset="0" stop-color="#ffb04a" />
            <stop offset="0.6" stop-color="#f2861c" />
            <stop offset="1" stop-color="#c25e0e" />
          </radialGradient>
          <linearGradient id="cm-vase" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#6a3018" />
            <stop offset="0.38" stop-color="#c06a38" />
            <stop offset="0.6" stop-color="#a5552b" />
            <stop offset="1" stop-color="#5a2812" />
          </linearGradient>
          <linearGradient id="cm-dough" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#f0b468" />
            <stop offset="1" stop-color="#c47a32" />
          </linearGradient>
          <clipPath id="cm-wallclip">
            <rect x="60" y="330" width="460" height="372" />
          </clipPath>
          <mask id="cm-cut" maskContentUnits="objectBoundingBox">
            <rect width="1" height="1" fill="white" />
            <path fill="black" d="M-0.1 0.84 H0 Q0.083 0.76 0.166 0.84 T0.333 0.84 T0.5 0.84 T0.666 0.84 T0.833 0.84 T1 0.84 H1.1 V1.1 H-0.1Z" />
            <circle cx="0.5" cy="0.42" r="0.12" fill="black" />
            {[0, 1, 2, 3, 4, 5].map((k) => {
              const a = (k / 6) * Math.PI * 2;
              return <circle cx={f(0.5 + Math.cos(a) * 0.26)} cy={f(0.42 + Math.sin(a) * 0.22)} r="0.07" fill="black" />;
            })}
          </mask>
        </defs>

        <!-- Sky, moon and stars -->
        <rect width="1600" height="900" fill="url(#cm-sky)" />
        <g class="stars">
          {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.s} style={`--d: ${s.d}s; --o: ${s.o}s`} />)}
        </g>
        <circle cx={MOON.x} cy={MOON.y} r={MOON.r * 3.4} fill="url(#cm-moonhalo)" />
        <circle cx={MOON.x} cy={MOON.y} r={MOON.r} fill="url(#cm-moon)" />
        <g class="craters">
          <circle cx={MOON.x - 14} cy={MOON.y - 8} r="8" fill="#d8ccb2" />
          <circle cx={MOON.x + 16} cy={MOON.y + 12} r="6" fill="#d8ccb2" />
          <circle cx={MOON.x + 4} cy={MOON.y - 22} r="4" fill="#ddd2ba" />
        </g>

        <!-- Hills and the town far away -->
        <path d={hillsFar} fill="#1e1440" />
        <g class="town">
          {town.map((l) => <rect x={l.x} y={l.y} width={l.s} height={l.s} style={`--d: ${l.d}s; --o: ${l.o}s`} />)}
        </g>
        <path d={hillsNear} fill="#170f30" />

        <!-- Ground -->
