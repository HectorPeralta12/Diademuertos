---
/**
 * Foreground foliage that frames a 2D section, so the night sky reads as a
 * place and not as a backdrop. Put it inside a sticky stage: it follows the
 * scene's --p with a little parallax (far leaves move less than near ones),
 * and its vines and stems sway slowly.
 *
 * `corners` picks which corners grow foliage: tl, tr (hanging vines) and
 * bl, br (bushes with cempasúchil). `seed` gives each section its own drawing.
 */
import { EDGE } from '../scripts/marigold';
import { colgante, mata, type Piece, type Flower, type Leaf } from '../scripts/follaje';

interface Props {
  corners: ('tl' | 'tr' | 'bl' | 'br')[];
  seed?: number;
}

const { corners, seed = 1 } = Astro.props;

const pieces = corners.map((corner, i) => ({
  corner,
  piece: (corner[0] === 't' ? colgante : mata)(seed * 13 + i * 7) as Piece,
}));
---

<div class="marco" aria-hidden="true">
  {
    pieces.map(({ corner, piece }) => {
      const leafPaths = (leaves: Leaf[]) =>
        leaves.map((l) => (
          <g>
            <path class="hoja" d={l.d} fill={l.fill} />
            <path class="vena" d={l.vein} />
          </g>
        ));
      const flowers = (list: Flower[]) =>
        list.map((f) => (
          <g transform={`translate(${f.x} ${f.y}) scale(${f.r})`}>
            {f.layers.map((l) => (
              <path d={l.d} fill={l.fill} stroke={l.stroke} stroke-width={l.stroke ? EDGE : undefined} opacity={l.opacity} />
            ))}
          </g>
        ));
      // Every depth and every swaying vine is its own picture: its ink filter is
      // painted once, and the parallax and the sway only move layers on the GPU
      const capa = (cls: string, body: any, style?: string) => (
        <svg class={`capa ${cls}`} viewBox="0 0 500 500" style={style}>
          <g class="tinta">{body}</g>
        </svg>
      );
      return (
        <div class={`esquina esquina--${corner}`}>
          {capa('lejos', leafPaths(piece.far.leaves))}
          {piece.near.sway.map((s, k) =>
            capa(
              'cerca mece',
              <>
                <path class="tallo" d={s.d} />
                {leafPaths(s.leaves)}
                {flowers(s.flowers)}
              </>,
              `transform-origin: ${s.ox / 5}% ${s.oy / 5}%; --d: ${5 + (k % 3) * 1.3}s; --k: ${k}`,
            ),
          )}
          {capa(
            'cerca',
            <>
              {leafPaths(piece.near.leaves)}
              {flowers(piece.near.flowers)}
            </>,
          )}
        </div>
      );
    })
  }
</div>

<style>
  /* Behind the section's text and drawings, in front of the sky */
  .marco {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    /* Grows in as the section starts and pulls back before it ends, so two
       sections never meet with their foliage cut along the same edge */
    --entra: min(clamp(0, var(--p, 0.5) / 0.1, 1), clamp(0, (0.97 - var(--p, 0.5)) / 0.1, 1));
  }

  .esquina {
    position: absolute;
    width: clamp(200px, 40vw, 640px);
    height: auto;
    aspect-ratio: 1;
    transition: translate 600ms var(--ease);
  }
  .capa {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    will-change: transform;
  }
  .esquina--tl { top: 0; left: 0; }
  .esquina--tr { top: 0; right: 0; scale: -1 1; }
  .esquina--bl { bottom: 0; left: 0; }
  .esquina--br { bottom: 0; right: 0; scale: -1 1; }
  /* Vines drop from above, bushes rise from below */
  .esquina--tl,
  .esquina--tr {
    translate: 0 calc((1 - var(--entra)) * -102%);
  }
  .esquina--bl,
  .esquina--br {
    translate: 0 calc((1 - var(--entra)) * 102%);
  }

  /* Parallax: near leaves drift more than far ones as the scene moves */
  .lejos {
    opacity: 0.9;
    translate: 0 calc((var(--p, 0.5) - 0.5) * 14px);
  }
  .cerca {
    translate: 0 calc((var(--p, 0.5) - 0.5) * -32px);
  }
  .cerca .tinta {
    filter: url(#trazo);
  }
  .esquina--tl .lejos,
  .esquina--tr .lejos {
    translate: 0 calc((var(--p, 0.5) - 0.5) * -14px);
  }

  .hoja {
    stroke: #04030c;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .lejos .hoja {
    stroke: #121036;
  }
  .vena {
    fill: none;
    stroke: #3a3680;
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.75;
  }
  .lejos .vena {
    opacity: 0.4;
  }
  .tallo {
    fill: none;
    stroke: #0a0922;
    stroke-width: 3;
    stroke-linecap: round;
  }

  .mece {
    animation: mece var(--d) ease-in-out infinite alternate;
    animation-delay: calc(var(--k) * -1.7s);
  }
  @keyframes mece {
    from { rotate: -1.6deg; }
    to { rotate: 1.6deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mece {
      animation: none;
    }
  }
</style>
