---
/**
 * Opening: the Xolo keeps watch, its painting kept alive in code (stars,
 * falling petals, candles, a blink). As you scroll, the copy leaves and the
 * camera follows the Xolo's gaze up into the sky; cempasúchil blooms until it
 * covers the screen, then the flowers open and shed their petals, and behind
 * them the camera comes down onto the whole altar. The last frame is the first
 * view of the next scene, so the hand over is invisible. Both paintings stay
 * at full resolution all along.
 */

// Share of the scene that holds on the painting before the camera starts moving
const HOLD = 0.28;
// The star the Xolo looks at, and the point of the altar the camera comes down to,
// as fractions of each painting
const STAR = { x: 0.2105, y: 0.1254 };
const ALTAR_TOP = { x: 0.548, y: 0.24 };
---

<section data-pintada class="scene inicio" id="inicio" data-scene="inicio" data-theme="noche" data-chapter="ofrenda" style="--len: 380" data-hold={HOLD}>
  <div class="stage" style={`--hold: ${HOLD}; --sx: ${STAR.x * 100}%; --sy: ${STAR.y * 100}%; --ax: ${ALTAR_TOP.x * 100}%; --ay: ${ALTAR_TOP.y * 100}%`}>
    <div class="art" aria-hidden="true" data-art>
      <img src="/images/xolo-hero.webp" srcset="/images/xolo-hero.webp 1672w, /images/xolo-hero@2x.webp 3344w" sizes="max(100vw, 177.7vh)" alt="" width="1672" height="941" fetchpriority="high" decoding="async" />
      <canvas data-ambience></canvas>
    </div>

    <!-- The same painting and framing as the altar scene's first view -->
    <div class="altar" aria-hidden="true" data-altar>
      <img src="/images/altar-general-4k.webp" alt="" width="1669" height="942" decoding="async" fetchpriority="low" />
    </div>

    <!-- Cempasúchil that blooms over the screen and opens to show the altar -->
    <canvas class="flores" aria-hidden="true" data-flores></canvas>
    <div class="shade" aria-hidden="true"></div>

    <div class="copy" id="contenido">
      <p class="mono kicker">1 y 2 de noviembre</p>
      <h1>Día de<br />Muertos</h1>
      <p class="lead">Una ofrenda para quienes vuelven a casa. <br />Recórrela nivel por nivel.</p>
      <div class="actions">
        <a class="btn btn--primary" href="#ofrenda">
          Recorrer la ofrenda
          <svg viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M205.66,149.66l-72,72a8,8,0,0,1-11.32,0l-72-72a8,8,0,0,1,11.32-11.32L120,196.69V40a8,8,0,0,1,16,0V196.69l58.34-58.35a8,8,0,0,1,11.32,11.32Z" /></svg>
        </a>
        <p class="mono proof">Con información del INAH y la UNESCO</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { $ } from '../../scripts/dom';
  import { clamp, onProgress, reducedMotion } from '../../scripts/scenes';
  import { ambience } from '../../scripts/xolo-ambience';
  import { florecer } from '../../scripts/florecer';

  const scene = $('[data-scene="inicio"]')!;
  const stage = $('.stage', scene)!;
  const hold = Number(scene.dataset.hold);
  const life = ambience($<HTMLCanvasElement>('[data-ambience]', scene)!, reducedMotion);

  // Only animate while the painting is on screen and the camera has not left it
  let visible = true;
  let moving = false;
  const sync = () => (visible && !moving ? life.play() : life.pause());
  new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    sync();
  }).observe(stage);

  const flores = florecer($<HTMLCanvasElement>('[data-flores]', scene)!);
  let last = 0;
  new ResizeObserver(() => {
    flores.layout();
    update(last);
  }).observe($('[data-flores]', scene)!);
  const smooth = (x: number) => x * x * (3 - 2 * x);

  function update(p: number) {
    last = p;
    // Once the camera lands, the altar scene underneath holds the same frame: hand over instantly
    scene.classList.toggle('is-done', p >= 0.999);
    const t = clamp((p - hold) / (1 - hold));
    if ((t > 0.05) !== moving) {
      moving = t > 0.05;
      sync();
    }
    // Up into the sky, following the Xolo's gaze
    const up = smooth(clamp(t / 0.5));
    stage.style.setProperty('--zoom', (1 + 1.6 * up * up).toFixed(4));
    // The flowers cover the screen by 0.5; behind them the paintings change places
    flores.draw(clamp((t - 0.24) / 0.3), clamp((t - 0.56) / 0.34));
    stage.style.setProperty('--art', (1 - clamp((t - 0.5) / 0.04)).toFixed(3));
    stage.style.setProperty('--altar', clamp((t - 0.5) / 0.04).toFixed(3));
    // Down onto the whole altar while the flowers open
    const down = smooth(clamp((t - 0.52) / 0.48));
    stage.style.setProperty('--zoom-altar', (1 + 1.8 * (1 - down) * (1 - down)).toFixed(4));
  }

  onProgress(scene, update);
</script>

<style>
  /* Sits above the altar scene, which starts pinned underneath (see Ofrenda) */
  .inicio {
    z-index: 2;
  }
  .inicio.is-done .stage {
    visibility: hidden;
  }

  .stage {
    background: var(--noche);
    container-type: size;
    --zoom: 1;
    --art: 1;
    --altar: 0;
    --zoom-altar: 1;
    /* Framing pans a little toward the star as the camera rises */
    --from: 0.68;
    --t: clamp(0, (var(--p) - var(--hold)) / (1 - var(--hold)), 1);
    --xf: calc(var(--from) + (0.5 - var(--from)) * min(1, var(--t) * 2));
  }

  /* The painting and its living layer, covering the stage like object-fit: cover */
  .art {
    --ratio: 1.7768;
    --w: max(100cqw, 100cqh * var(--ratio));
    position: absolute;
    top: 50%;
    left: calc((100cqw - var(--w)) * var(--xf));
    width: var(--w);
    height: calc(var(--w) / var(--ratio));
    /* translate, not transform: the zoom must not scale this offset */
    translate: 0 -50%;
    transform-origin: var(--sx) var(--sy);
    scale: var(--zoom);
    opacity: var(--art);
    will-change: scale;
  }
  .art img,
  .art canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Same box as the altar scene's camera at its first view (Ofrenda .views) */
  .altar {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 100lvh * 1669 / 942);
    aspect-ratio: 1669 / 942;
    translate: -50% -50%;
    transform-origin: var(--ax) var(--ay);
    scale: var(--zoom-altar);
    opacity: var(--altar);
    will-change: scale;
  }
  .altar img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .flores {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* A flat veil for the copy; it lifts before the camera moves */
  .shade {
    position: absolute;
    inset: 0;
    background: var(--noche);
    opacity: calc(0.2 * (1 - clamp(0, var(--p) / var(--hold), 1)));
  }

  .copy {
    position: absolute;
    left: var(--gutter);
    bottom: calc(96px + var(--chrome));
    max-width: 680px;
    opacity: calc(1 - var(--p) * 4.5);
    transform: translateY(calc(var(--p) * -160px));
  }

  .kicker {
    color: var(--cera);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.6);
  }

  h1 {
    margin-top: 16px;
    font-size: var(--t-7xl);
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, #ffffff, #9b9b9b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 2px 24px rgb(0 0 0 / 0.35));
  }

  .lead {
    margin-top: 24px;
    max-width: 680px;
    font-size: var(--t-xl);
    line-height: 28px;
    font-weight: 300;
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.5);
  }

  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .proof {
    color: var(--cera);
    opacity: 0.8;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.6);
  }

  @media (min-width: 768px) {
    h1 {
      font-size: var(--t-8xl);
    }
  }
  @media (min-width: 1280px) {
    h1 {
      font-size: var(--t-9xl);
    }
  }
  @media (max-width: 767px) {
    .stage {
      --from: 0.74;
    }
    .lead br {
      display: none;
    }
  }
</style>
