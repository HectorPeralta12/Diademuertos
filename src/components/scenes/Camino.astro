          {
            votives.map((v, i) => (
              <g class="candle votive" style={`--at: ${v.at}; --i: ${i + 3}`}>
                <circle class="halo" cx={v.x} cy="612" r="46" fill="url(#cm-glow)" />
                <rect x={v.x - 6} y="618" width="12" height="13" fill="#f6efe2" opacity="0.85" />
                <path d={`M${v.x - 8} 612 L ${v.x - 7} 632 H ${v.x + 7} L ${v.x + 8} 612 Z`} fill="#f3ece0" opacity="0.26" />
                <ellipse cx={v.x} cy="612" rx="8" ry="1.8" fill="none" stroke="#fbf5e8" stroke-width="0.8" opacity="0.5" />
                <path d={`M${v.x} 618 q 0.5 -1.5 -0.4 -3`} stroke="#2a1d16" stroke-width="1" fill="none" stroke-linecap="round" />
                <g class="flame">
