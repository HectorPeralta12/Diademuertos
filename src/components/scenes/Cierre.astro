---
import { BASE } from '../../scripts/base';
import { lang, strings } from '../../i18n';
/**
 * Closing: back to the Xolo under the stars, a farewell and the sources.
 */

const t = strings(Astro.currentLocale).cierre;
const code = lang(Astro.currentLocale);
// UNESCO has the page in English too; the Mexican sources are only in Spanish
const HREFS = [
  'https://www.inah.gob.mx/index.php/foto-del-dia/ofrendas-para-los-muertos',
  'https://www.inah.gob.mx/especiales-inah/articulos/el-origen-del-dia-de-muertos',
  code === 'es'
    ? 'https://ich.unesco.org/es/RL/las-fiestas-indigenas-dedicadas-a-los-muertos-00054'
    : 'https://ich.unesco.org/en/RL/indigenous-festivity-dedicated-to-the-dead-00054',
  'https://www.cultura.gob.mx/noticias/patrimonio-cultural-arquitectura-y-turismo/16767-el-culto-a-los-muertos-costumbre-que-se-remonta-a-la-epoca-prehispanica.html',
];
const sources = HREFS.map((href, i) => ({ href, label: t.sourceLabels[i] }));
---

<section data-pintada data-funde="arriba" class="scene cierre" data-scene="cierre" data-theme="noche" data-chapter="preguntas" style="--len: 200">
  <div class="stage">
    <img class="sky" src={`${BASE}/images/xolo-hero.webp`} srcset={`${BASE}/images/xolo-hero.webp 1672w, ${BASE}/images/xolo-hero@2x.webp 3344w`} sizes="max(100vw, 177.7vh)" alt={t.alt} loading="lazy" decoding="async" />
    <div class="shade" aria-hidden="true"></div>

    <div class="farewell">
      <h2>{t.title[0]}<br />{t.title[1]}</h2>
      <div class="actions">
        <a class="btn btn--primary" href="#ofrenda">
          {t.cta}
          <svg viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M205.66,117.66a8,8,0,0,1-11.32,0L136,59.31V216a8,8,0,0,1-16,0V59.31L61.66,117.66a8,8,0,0,1-11.32-11.32l72-72a8,8,0,0,1,11.32,0l72,72A8,8,0,0,1,205.66,117.66Z" /></svg>
        </a>
      </div>
    </div>

    <footer class="foot">
      <div>
        <p class="mono label">{t.sources}</p>
        <ul>
          {
            sources.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="mono credit">{t.credit}</p>
    </footer>
  </div>
</section>

<style>
  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% 50%;
    transform: scale(calc(1.12 - var(--p) * 0.12));
  }

  .shade {
    position: absolute;
    inset: 0;
    background: var(--noche);
    opacity: 0.55;
  }

  .farewell {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    transform: translateY(calc(-50% + (1 - clamp(0, var(--p) * 3, 1)) * 48px));
    opacity: clamp(0, calc(var(--p) * 3), 1);
    max-width: 680px;
  }

  h2 {
    font-size: var(--t-7xl);
    line-height: 1;
    letter-spacing: -0.02em;
    background: linear-gradient(90deg, #ffffff, #9b9b9b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .actions {
    margin-top: 32px;
  }

  .foot {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(24px + var(--chrome));
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
  }
  .label {
    color: var(--cempasuchil);
  }
  .foot ul {
    margin-top: 8px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 4px;
    font-size: var(--t-sm);
    line-height: 20px;
  }
  .foot a {
    text-decoration-color: color-mix(in srgb, var(--fg) 40%, transparent);
    transition: text-decoration-color 400ms var(--ease);
  }
  .foot a:hover {
    text-decoration-color: currentColor;
  }
  .credit {
    color: var(--fg-dim);
  }

  @media (min-width: 1280px) {
    h2 {
      font-size: var(--t-8xl);
    }
  }
  @media (max-width: 767px) {
    h2 {
      font-size: var(--t-5xl);
    }
    .farewell {
      top: 32%;
    }
  }
</style>
