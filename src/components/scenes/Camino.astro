        <!-- Papel picado from the corner of the roof to the arch -->
        <path d={cordPath(skyCord)} fill="none" stroke="#d9c7a8" stroke-width="1.5" opacity="0.6" />
        <circle cx={skyCord.a[0]} cy={skyCord.a[1]} r="2.5" fill="#2a1d16" />
        {
