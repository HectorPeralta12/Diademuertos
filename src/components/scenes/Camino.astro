---
import { BASE } from '../../scripts/base';
/**
 * The marigold path, from the door of the house to the altar, at night.
 *
 * One painting (assets/altar/altar_muerto.webp), wider than any screen: the
 * camera travels across it from the door to the altar as the story moves. The
 * scene starts in shadow; a warm light follows the soul down the painted path
 * and leaves it lit, the Xolo of light walks ahead of it, and when they arrive
 * the altar's candles light up one by one and the Xolo sits facing them.
 *
 * Everything that moves is drawn on canvases over the painting, in the
 * painting's own coordinates (ART, 1200 × 480).
 */

import { strings } from '../../i18n';

const t = strings(Astro.currentLocale).camino;
// The painting's field, its aspect is 2.5 : 1
const ART = { w: 1200, h: 480 };
---

<section data-pintada data-funde="arriba abajo" class="scene camino" data-scene="camino" data-theme="noche" data-chapter="elementos" style="--len: 560">
  <div class="stage">
    <div class="world" data-world data-art={JSON.stringify(ART)}>
      <img
        class="pintura"
        src={`${BASE}/images/camino-2800.webp`}
        srcset={`${BASE}/images/camino-1600.webp 1600w, ${BASE}/images/camino-2800.webp 2800w, ${BASE}/images/camino-4000.webp 4000w`}
        sizes="max(100vw, 250lvh)"
        alt={t.alt}
        width="4000"
        height="1600"
        fetchpriority="low"
        decoding="async"
      />
    </div>
    <canvas class="capa" data-velo aria-hidden="true"></canvas>
    <canvas class="capa" data-luces aria-hidden="true"></canvas>
    <canvas class="capa" data-polvo aria-hidden="true"></canvas>

    <ol class="captions stack">
      {
        t.beats.map((b, i) => (
          <li class="beat" data-beat={['0 0.34', '0.34 0.76', '0.76'][i]}>
            <p class="mono">{b.kicker}</p>
            <h2>{b.title}</h2>
            <p class="text">{b.text}</p>
            <p class="mono source">{b.source}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { BASE } from '../../scripts/base';
  import { $ } from '../../scripts/dom';
  import { clamp, onProgress, onResize, reducedMotion } from '../../scripts/scenes';
  import { polvo } from '../../scripts/polvo';

  const scene = $('[data-scene="camino"]')!;
  const world = $('[data-world]', scene)!;
  const ART = JSON.parse(world.dataset.art!) as { w: number; h: number };
  const veil = $<HTMLCanvasElement>('[data-velo]', scene)!;
  const lights = $<HTMLCanvasElement>('[data-luces]', scene)!;
  const vctx = veil.getContext('2d')!;
  const ctx = lights.getContext('2d')!;

  // ---- Places in the painting (ART coordinates, measured on altar_muerto.webp)

  // The petal path: from the foot of the steps to the front of the altar
  const PATH: [number, number][] = [
    [165, 410], [230, 414], [320, 415], [420, 414], [520, 414], [620, 413],
    [720, 416], [820, 419], [900, 422], [960, 428], [1010, 440],
  ];
  const LANTERN = { x: 74, y: 210 };
  const WINDOW = { x: 252, y: 262 };
  const STEP_CANDLE = { x: 272, y: 392 };
  // The altar's candles, lit from the front outward, then up
  const CANDLES = [
    { x: 1110, y: 410, at: 0.8 },
    { x: 930, y: 394, at: 0.81 },
    { x: 1123, y: 382, at: 0.82 },
    { x: 945, y: 364, at: 0.83 },
    { x: 1126, y: 337, at: 0.845 },
    { x: 1024, y: 334, at: 0.855 },
    { x: 1035, y: 316, at: 0.865 },
    { x: 1081, y: 271, at: 0.875 },
    { x: 1162, y: 256, at: 0.885 },
    { x: 1056, y: 242, at: 0.895 },
  ];
  const ALTAR = { x: 1080, y: 330 };

  // ---- Timeline (scene progress)
  const OPEN = 0.08; // the soul leaves the house
  const ARRIVE = 0.78; // it reaches the altar
  const along = (p: number) => clamp((p - OPEN) / (ARRIVE - OPEN));

  // The path as a polyline with lengths, to walk it at an even pace
  const lengths = [0];
  for (let i = 1; i < PATH.length; i++) lengths.push(lengths[i - 1] + Math.hypot(PATH[i][0] - PATH[i - 1][0], PATH[i][1] - PATH[i - 1][1]));
  const TOTAL = lengths[lengths.length - 1];
  function pointAt(u: number) {
    const want = clamp(u) * TOTAL;
    let i = 1;
    while (i < lengths.length - 1 && lengths[i] < want) i++;
    const k = (want - lengths[i - 1]) / (lengths[i] - lengths[i - 1] || 1);
    const [x0, y0] = PATH[i - 1];
    const [x1, y1] = PATH[i];
    return { x: x0 + (x1 - x0) * k, y: y0 + (y1 - y0) * k, angle: Math.atan2(y1 - y0, x1 - x0) };
  }

  // ---- The Xolo: the guide's walking poses, and sitting with its back to us at the end
  const load = (src: string) => {
    const img = new Image();
    img.decoding = 'async';
    img.src = src;
    return img;
  };
  const POSES = [`${BASE}/images/guia/paso-2.webp`, `${BASE}/images/guia/paso-1.webp`, `${BASE}/images/guia/paso-3.webp`].map(load);
  const SEATED = load(`${BASE}/images/guia/sentado.webp`);
  const CYCLE = [0, 1, 2, 1];
  const STRIDE = 14; // ART units walked per pose
  const XOLO_H = 60; // dog height in ART units (walking frames are 328 px tall)
  const AHEAD = 0.05; // how far ahead of the soul it walks

  // ---- Copal smoke sprite
  const puff = document.createElement('canvas');
  puff.width = puff.height = 64;
  {
    const g = puff.getContext('2d')!;
    const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    grad.addColorStop(0, 'rgba(236, 226, 248, 0.45)');
    grad.addColorStop(1, 'rgba(225, 215, 240, 0)');
    g.fillStyle = grad;
    g.fillRect(0, 0, 64, 64);
  }
  const smoke = Array.from({ length: 22 }, (_, i) => ({ phase: i / 22, wobble: Math.random() * 6, size: 0.7 + Math.random() * 0.6 }));

  // ---- Camera: the painting covers the stage; the view slides to keep the soul in frame
  let vw = 0;
  let vh = 0;
  let dpr = 1;
  let scale = 1; // screen px per ART unit
  let worldW = 0;
  let offset = 0; // screen px the painting is shifted left
  const dust = polvo($<HTMLCanvasElement>('[data-polvo]', scene)!);

  function measure() {
    vw = scene.clientWidth;
    vh = window.innerHeight;
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    worldW = Math.max(vw, vh * (ART.w / ART.h));
    scale = worldW / ART.w;
    world.style.width = `${worldW}px`;
    for (const c of [veil, lights]) {
      c.width = Math.round(vw * dpr);
      c.height = Math.round(vh * dpr);
    }
  }

  let p = 0;
  function frameCamera() {
    // The camera keeps the soul a little left of center, from the door to the altar
    const u = along(p);
    const target = pointAt(u).x * scale - vw * 0.42;
    offset = clamp(target, 0, worldW - vw);
    const top = (vh - worldW * (ART.h / ART.w)) / 2;
    world.style.transform = `translate3d(${(-offset).toFixed(1)}px, ${top.toFixed(1)}px, 0)`;
    return top;
  }

  // Maps ART coordinates to the canvases (CSS px × dpr)
  function toScreen(c: CanvasRenderingContext2D, top: number) {
    c.setTransform(dpr * scale, 0, 0, dpr * scale, -offset * dpr, top * dpr);
  }

  function glow(c: CanvasRenderingContext2D, x: number, y: number, r: number, rgb: string, a: number) {
    if (a <= 0) return;
    const g = c.createRadialGradient(x, y, 0, x, y, r);
    g.addColorStop(0, `rgba(${rgb}, ${a})`);
    g.addColorStop(1, `rgba(${rgb}, 0)`);
    c.fillStyle = g;
    c.beginPath();
    c.arc(x, y, r, 0, Math.PI * 2);
    c.fill();
  }

  let lastStep = -1;
  let lastTime = 0;

  function draw(now: number) {
    const time = reducedMotion ? 0 : now / 1000;
    const dt = lastTime ? Math.min(0.05, (now - lastTime) / 1000) : 0;
    lastTime = now;
    const top = frameCamera();
    const u = along(p);
    const lit = clamp((p - ARRIVE) / 0.12);
    const out = clamp((p - OPEN * 0.5) / 0.05); // the soul and the Xolo appear at the door
    const soul = pointAt(u);
    const flick = (i: number) => (reducedMotion ? 0.8 : 0.72 + 0.2 * Math.sin(time * 7.3 + i * 1.7) + 0.08 * Math.sin(time * 13 + i));

    // ---- Night veil, with the light carved out of it
    vctx.setTransform(1, 0, 0, 1, 0, 0);
    vctx.clearRect(0, 0, veil.width, veil.height);
    vctx.globalCompositeOperation = 'source-over';
    vctx.fillStyle = `rgba(9, 7, 32, ${0.5 - 0.32 * lit})`;
    vctx.fillRect(0, 0, veil.width, veil.height);
    toScreen(vctx, top);
    vctx.globalCompositeOperation = 'destination-out';
    glow(vctx, LANTERN.x, LANTERN.y + 30, 110, '0,0,0', 0.9);
    glow(vctx, WINDOW.x, WINDOW.y + 20, 80, '0,0,0', 0.8);
    glow(vctx, STEP_CANDLE.x, STEP_CANDLE.y, 50, '0,0,0', 0.7);
    // The path stays lit behind the soul
    if (out > 0) {
      for (let t = 0; t <= u; t += 0.02) {
        const at = pointAt(t);
        glow(vctx, at.x, at.y, 55, '0,0,0', 0.55 * out);
      }
      glow(vctx, soul.x, soul.y - 20, 130, '0,0,0', 0.9 * out);
    }
    for (const c of CANDLES) glow(vctx, c.x, c.y, 80, '0,0,0', clamp((p - c.at) * 30));
    glow(vctx, ALTAR.x, ALTAR.y, 260, '0,0,0', 0.8 * lit);

    // ---- Lights and life
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, lights.width, lights.height);
    toScreen(ctx, top);
    ctx.globalCompositeOperation = 'lighter';
    glow(ctx, LANTERN.x, LANTERN.y, 46, '255, 190, 100', 0.28 * flick(0));
    glow(ctx, WINDOW.x, WINDOW.y, 40, '255, 180, 90', 0.18 * flick(1));
    glow(ctx, STEP_CANDLE.x, STEP_CANDLE.y - 6, 24, '255, 200, 120', 0.35 * flick(2));
    CANDLES.forEach((c, i) => {
      const on = clamp((p - c.at) * 30);
      glow(ctx, c.x, c.y - 4, 34, '255, 196, 110', 0.42 * on * flick(i + 3));
    });
    glow(ctx, ALTAR.x, ALTAR.y + 40, 220, '255, 160, 70', 0.16 * lit);

    // The soul: a small light floating over the path, with a short trail
    const fade = out * (1 - clamp((p - ARRIVE - 0.04) / 0.05));
    if (fade > 0) {
      for (let i = 10; i >= 0; i--) {
        const at = pointAt(u - i * 0.012);
        const bob = Math.sin(time * 2 + i) * 2;
        const lift = 26 + Math.sin(time * 1.6) * 3;
        glow(ctx, at.x, at.y - lift + bob, i === 0 ? 16 : 7 - i * 0.4, '255, 236, 190', fade * (1 - i / 11) * 0.7);
      }
    }
    ctx.globalCompositeOperation = 'source-over';

    // Copal smoke over the altar once it is lit
    if (lit > 0) {
      for (const s of smoke) {
        const age = reducedMotion ? s.phase : (s.phase + time * 0.12) % 1;
        const y = 390 - age * 200;
        const x = ALTAR.x - 20 + Math.sin(age * 5 + s.wobble) * (6 + age * 30);
        const size = (8 + age * 40) * s.size;
        ctx.globalAlpha = lit * (1 - age) * Math.min(1, age * 6) * 0.3;
        ctx.drawImage(puff, x - size / 2, y - size / 2, size, size);
      }
      ctx.globalAlpha = 1;
    }

    // ---- The Xolo, ahead of the soul; it sits facing the altar when the candles light
    if (out > 0) {
      const ux = Math.min(1, u + AHEAD);
      const at = pointAt(ux);
      const arrived = ux >= 1;
      const sit = clamp((p - ARRIVE - 0.02) / 0.04);
      const k = 1 + (at.y - 404) / 120; // a little bigger nearer to us
      const stepIndex = Math.floor((ux * TOTAL) / STRIDE);
      const pose = POSES[reducedMotion || arrived ? 1 : CYCLE[stepIndex % CYCLE.length]];
      ctx.shadowColor = 'rgba(255, 196, 90, 0.8)';
      ctx.shadowBlur = 16 * k * scale * dpr;
      if (sit < 1 && pose.complete && pose.naturalWidth) {
        const h = XOLO_H * k;
        const w = (h * pose.naturalWidth) / pose.naturalHeight;
        ctx.save();
        ctx.globalAlpha = out * (1 - sit);
        ctx.translate(at.x, at.y + 3);
        ctx.rotate(at.angle * 0.4);
        ctx.scale(-1, 1); // the poses face left; the path runs right
        ctx.drawImage(pose, -w / 2, -h, w, h);
        ctx.restore();
      }
      if (sit > 0 && SEATED.complete && SEATED.naturalWidth) {
        const h = XOLO_H * k * (SEATED.naturalHeight / 328);
        const w = (h * SEATED.naturalWidth) / SEATED.naturalHeight;
        ctx.globalAlpha = out * sit;
        ctx.drawImage(SEATED, at.x - w / 2, at.y + 3 - h, w, h);
        ctx.globalAlpha = 1;
      }
      ctx.shadowBlur = 0;

      // Gold dust: a puff at every step, a slow shimmer once it waits
      const sx = at.x * scale - offset;
      const sy = at.y * scale + top;
      if (!reducedMotion) {
        if (stepIndex !== lastStep && !arrived) {
          dust.emit(sx, sy, 6, 12 * scale);
          lastStep = stepIndex;
        } else if (Math.random() < 0.2) {
          dust.emit(sx + (Math.random() - 0.5) * 24 * scale, sy - Math.random() * XOLO_H * scale, 1, 4);
        }
      }
    }
    dust.step(dt);
  }

  // A loop runs only while the scene is on screen: the flames, the soul and the smoke move with time
  let raf = 0;
  let visible = false;
  const loop = (now: number) => {
    draw(now);
    if (visible && !reducedMotion) raf = requestAnimationFrame(loop);
  };
  new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    cancelAnimationFrame(raf);
    lastTime = 0;
    if (visible) raf = requestAnimationFrame(loop);
  }).observe(scene);

  measure();
  onResize(() => {
    measure();
    draw(performance.now());
  });
  onProgress(scene, (value) => {
    p = value;
    if (reducedMotion || !visible) draw(performance.now());
  });
</script>

<style>
  .stage {
    background: #0c0a24;
  }

  /* The painting, as tall as the stage and wider than it; the script slides it */
  .world {
    position: absolute;
    top: 0;
    left: 0;
    aspect-ratio: 2.5;
    will-change: transform;
  }
  .pintura {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .capa {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Captions sit in the sky, top left, clear of the path */
  .captions {
    position: absolute;
    left: var(--gutter);
    top: 96px;
    z-index: 1;
    list-style: none;
    padding: 0;
    max-width: 480px;
  }
  .captions .mono {
    color: var(--accent);
  }
  .captions .source {
    margin-top: 16px;
    color: var(--fg-dim);
  }
  h2 {
    margin-top: 12px;
    font-size: var(--t-4xl);
    line-height: 40px;
    text-shadow: 0 2px 16px rgb(7 5 26 / 0.8);
  }
  .text {
    margin-top: 12px;
    font-size: var(--t-xl);
    line-height: 28px;
    font-weight: 300;
    text-shadow: 0 1px 12px rgb(7 5 26 / 0.9);
  }

  @media (max-width: 767px) {
    h2 {
      font-size: var(--t-2xl);
      line-height: 32px;
    }
    .text {
      font-size: var(--t-base);
      line-height: 24px;
    }
  }
</style>
