          }

          <!-- Tiers: purple cloth fronts with a papel picado trim, pale tops in perspective -->
          {
            tiers.map((t) => (
              <g>
                <path d={`M${t.x} ${t.y} L ${t.x + t.w} ${t.y} L ${t.x + t.w - t.top} ${t.y - t.top} L ${t.x + t.top} ${t.y - t.top} Z`} fill="url(#cm-clothtop)" />
                <rect x={t.x} y={t.y} width={t.w} height={t.h} fill="url(#cm-cloth)" />
                <rect x={t.x} y={t.y} width={t.w} height="10" fill="#f29a1c" />
                <path
                  d={`M${t.x} ${t.y + 10} ${Array.from({ length: Math.round(t.w / 12) }, (_, k) => {
                    const step = t.w / Math.round(t.w / 12);
                    return `L ${f(t.x + k * step + step / 2)} ${t.y + 18} L ${f(t.x + (k + 1) * step)} ${t.y + 10}`;
                  }).join(' ')} Z`}
                  fill="#f29a1c"
                />
                <rect x={t.x + t.w / 2 - 28} y={t.y + 22} width="56" height={t.h - 26} fill="#e8577e" mask="url(#cm-cut)" opacity="0.85" />
                <rect x={t.x} y={t.y + t.h - 6} width={t.w} height="6" fill="#000" opacity="0.3" />
              </g>
            ))
          }

          <!-- Top tier: the portrait -->
          <g class="portrait">
            <ellipse cx="1300" cy="478" rx="46" ry="3" fill="#000" opacity="0.35" />
            <rect x="1258" y="376" width="84" height="102" rx="3" fill="#4a2a18" />
            <rect x="1262.5" y="380.5" width="75" height="93" rx="1.5" fill="none" stroke="#c9a86a" stroke-width="1.2" opacity="0.75" />
            <rect x="1266" y="384" width="68" height="86" fill="url(#cm-sepia)" />
            <circle cx="1300" cy="413" r="13" fill="#7a5e40" />
            <path d="M1276 470 C 1277 446 1287 434 1300 434 C 1313 434 1323 446 1324 470 Z" fill="#6a4f34" />
            <rect x="1266" y="384" width="68" height="4" fill="#000" opacity="0.18" />
            <rect x="1258" y="376" width="84" height="102" rx="3" fill="none" stroke="#2a170d" stroke-width="1" opacity="0.6" />
          </g>

          <!-- Vases of marigolds and cockscomb on the top tier -->
          {
            vases.map(({ x, flowers }, k) => (
              <g>
                <!-- Stems from the mouth of the vase to each head, with a few leaves -->
                {flowers.map((m) => {
                  const cx = m.x + m.r / 2;
                  const cy = m.y + m.r / 2;
                  const sx = x + (cx - x) * 0.25;
                  return <path d={`M${f(sx)} 432 Q ${f(sx + (cx - sx) * 0.2)} ${f((cy + 432) / 2)} ${f(cx)} ${f(cy)}`} stroke="#3d6b2a" stroke-width="1.8" fill="none" stroke-linecap="round" />;
                })}
                <path d={k ? `M${x - 2} 426 q -12 -4 -16 -14 q 12 2 16 12 z` : `M${x + 2} 426 q 12 -4 16 -14 q -12 2 -16 12 z`} fill="#3d6b2a" />
                <!-- Cockscomb (terciopelo) behind the marigolds -->
                <path d={`M${x + (k ? 9 : -9) - 6} 404 C ${x + (k ? 9 : -9) - 9} 392 ${x + (k ? 9 : -9) - 4} 380 ${x + (k ? 9 : -9) - 1} 386 C ${x + (k ? 9 : -9) + 1} 376 ${x + (k ? 9 : -9) + 8} 380 ${x + (k ? 9 : -9) + 6} 390 C ${x + (k ? 9 : -9) + 9} 394 ${x + (k ? 9 : -9) + 6} 404 ${x + (k ? 9 : -9)} 405 Z`} fill="#b3134f" />
                {flowers.map((m) => <use href={m.v} x={m.x} y={m.y} width={m.r} height={m.r} transform={`rotate(${m.rot} ${m.x + m.r / 2} ${m.y + m.r / 2})`} />)}
                <!-- The vase: foot, round belly, narrow neck and a flared lip -->
                <ellipse cx={x} cy="466" rx="13" ry="2.5" fill="#000" opacity="0.35" />
                <path d={`M${x - 10} 466 C ${x - 19} 458 ${x - 19} 443 ${x - 8} 436 L ${x - 8} 432 H ${x + 8} L ${x + 8} 436 C ${x + 19} 443 ${x + 19} 458 ${x + 10} 466 Z`} fill="url(#cm-vase)" />
                <rect x={x - 11} y="428" width="22" height="5" rx="2" fill="#a0532c" />
                <path d={`M${x - 15.5} 449 Q ${x} 454 ${x + 15.5} 449`} stroke="#e8577e" stroke-width="2.5" fill="none" />
                <path d={`M${x - 14} 455 Q ${x} 459 ${x + 14} 455`} stroke="#ffd27a" stroke-width="1" fill="none" opacity="0.8" />
              </g>
            ))
          }

          <!-- Middle tier: pan de muerto, glass of water, oranges -->
          <g>
            <!-- Pan de muerto: a domed loaf, its four bones in a cross and the ball on top -->
            <ellipse cx="1300" cy="549" rx="44" ry="5" fill="#000" opacity="0.35" />
            <path d="M1260 548 C 1259 532 1276 518 1300 518 C 1324 518 1341 532 1340 548 Q 1300 552 1260 548 Z" fill="url(#cm-bread)" />
            <path d="M1262 545 Q 1300 550 1338 545 Q 1340 547 1340 548 Q 1300 552 1260 548 Q 1260 546 1262 545 Z" fill="#7a4216" opacity="0.5" />
            {sugar.map((g) => <circle cx={g.x} cy={g.y} r={g.s} fill="#fff6e4" opacity="0.6" />)}
            {
              [...bonesBack, ...bonesFront].map((b, j) => (
                <g opacity={j < 2 ? 0.9 : 1}>
                  {b.map((k) => <circle cx={k.x} cy={k.y + 1.1} r={k.r} fill="#7a4216" opacity="0.55" />)}
                  {b.map((k) => <circle cx={k.x} cy={k.y} r={k.r} fill="url(#cm-dough)" />)}
                  {b.map((k) => <circle cx={f(k.x - k.r * 0.3)} cy={f(k.y - k.r * 0.35)} r={f(k.r * 0.38)} fill="#ffe2ad" opacity="0.7" />)}
                </g>
              ))
            }
            <circle cx="1300" cy="519.5" r="6.5" fill="#7a4216" opacity="0.5" />
            <circle cx="1300" cy="518" r="6.5" fill="url(#cm-dough)" />
            <circle cx="1298" cy="516" r="2.4" fill="#ffe2ad" opacity="0.75" />
            <!-- Glass of water -->
            <path d="M1235 524 L 1237 548 H 1251 L 1253 524 Z" fill="#bcd7ff" opacity="0.3" />
            <path d="M1236.4 531 L 1237.6 547 H 1250.4 L 1251.6 531 Z" fill="#9cc2ff" opacity="0.35" />
            <ellipse cx="1244" cy="524" rx="9" ry="1.6" fill="none" stroke="#e6f0ff" stroke-width="0.8" opacity="0.6" />
            <rect x="1238" y="527" width="2.5" height="19" fill="#fff" opacity="0.45" />
            {[1351, 1364, 1377, 1357.5, 1370.5].map((x, k) => (
              <g>
                <circle cx={x} cy={k < 3 ? 541 : 530} r="7" fill="url(#cm-orange)" />
                <circle cx={x + 0.5} cy={k < 3 ? 535 : 524} r="1" fill="#3d5a24" />
              </g>
            ))}
          </g>

          <!-- Bottom tier: sugar skulls -->
          {
            [1222, 1378].map((x, k) => (
              <g>
                <ellipse cx={x} cy="644" rx="12" ry="2" fill="#000" opacity="0.3" />
                <path
                  d={`M${x} 612 C ${x + 8} 612 ${x + 13} 618 ${x + 13} 626 C ${x + 13} 631 ${x + 11} 634 ${x + 8} 635 L ${x + 8} 641 Q ${x} 645 ${x - 8} 641 L ${x - 8} 635 C ${x - 11} 634 ${x - 13} 631 ${x - 13} 626 C ${x - 13} 618 ${x - 8} 612 ${x} 612 Z`}
                  fill="#f6efe2"
                />
                <path d={`M${x - 8} 638.5 H ${x + 8} M${x - 4} 636.5 v 4.5 M${x} 636.5 v 5 M${x + 4} 636.5 v 4.5`} stroke="#c9b9a0" stroke-width="0.8" fill="none" />
                {[-5, 5].map((dx) => (
                  <g>
                    <circle cx={x + dx} cy="627" r="3.8" fill={k ? '#1f9e8a' : '#e8577e'} />
                    <circle cx={x + dx} cy="627" r="1.5" fill="#2a1d16" opacity="0.6" />
                  </g>
                ))}
                <path d={`M${x} 631 l -1.8 3 h 3.6 z`} fill="#7b2d8e" />
                <path d={`M${x - 9} 622 q 4 -3.5 8 0 M${x + 1} 622 q 4 -3.5 8 0`} stroke="#f29a1c" stroke-width="1.4" fill="none" stroke-linecap="round" />
                <circle cx={x} cy="617" r="2" fill={k ? '#e8577e' : '#1f9e8a'} />
                {[0, 1, 2, 3, 4].map((j) => <circle cx={f(x + Math.cos((j / 5) * Math.PI * 2) * 3.2)} cy={f(617 + Math.sin((j / 5) * Math.PI * 2) * 3.2)} r="1.3" fill="#f29a1c" />)}
              </g>
            ))
          }

          <!-- Copal burner on the ground, in front -->
          <g class="copal">
            <path d="M1282 752 h36 l-6 -14 h-24 z" fill="url(#cm-clay)" />
            <path d="M1270 738 q 30 18 60 0 l -4 -12 h -52 z" fill="url(#cm-clay)" />
            <ellipse cx="1300" cy="726" rx="26" ry="6" fill="#2a1208" />
            <ellipse cx="1300" cy="726" rx="16" ry="3.5" fill="#ff7a2a" class="embers" />
          </g>
        </g>
      </svg>

      <!-- The arch never changes, so it gets a layer of its own that is painted once,
           instead of being repainted with every flicker of the candles around it -->
      <svg class="art part arch-layer" viewBox={ARCH_BOX.viewBox} style={ARCH_BOX.style} aria-hidden="true">
        <g class="arch">
          <!-- The frame the flowers are tied to, mostly hidden behind them -->
          <path d="M1104 718 V 470 A 196 196 0 0 1 1496 470 V 718" fill="none" stroke="#5a2a0c" stroke-width="16" />
          {arch.map((m) => <use href={m.v} x={m.x} y={m.y} width={m.r} height={m.r} transform={`rotate(${m.rot} ${m.x + m.r / 2} ${m.y + m.r / 2})`} />)}
        </g>
      </svg>

      <!-- In front of the arch: the night over the altar and the candles -->
      <svg class="art part" viewBox={FRONT_BOX.viewBox} style={FRONT_BOX.style} aria-hidden="true">
        <!-- Night veil over the altar: it lifts as the candles light -->
        <ellipse class="veil" cx="1300" cy="520" rx="330" ry="330" fill="url(#cm-night)" />

        <!-- Candles -->
        {
          candles.map((c, i) => (
            <g class="candle" style={`--at: ${c.at}; --i: ${i}`}>
              <ellipse cx={c.x} cy={c.y} rx="9" ry="2" fill="#000" opacity="0.3" />
              <rect x={c.x - 7} y={c.y - c.h} width="14" height={c.h} rx="1.5" fill="url(#cm-wax)" />
              <ellipse cx={c.x} cy={c.y - c.h} rx="7" ry="2" fill="#fffaf0" />
              <path d={`M${c.x - 7} ${c.y - c.h} q 0.5 9 -0.2 13 q 2.6 1 2.8 -3 q 0.4 -6 0.4 -10 z`} fill="#efe6d4" />
              <path d={`M${c.x} ${c.y - c.h} q 0.6 -2.4 -0.6 -4.8`} stroke="#2a1d16" stroke-width="1.3" fill="none" stroke-linecap="round" />
              <circle class="halo" cx={c.x} cy={c.y - c.h - 12} r="58" fill="url(#cm-glow)" />
              <g class="flame">
                <path d={flame(c.x, c.y - c.h - 2, 24, 5.6)} fill="url(#cm-flame)" />
                <path d={flame(c.x, c.y - c.h - 2.5, 9, 2.2)} fill="#fffbe8" />
              </g>
            </g>
          ))
        }
      </svg>
      <canvas class="fx" data-fx aria-hidden="true"></canvas>
    </div>

    <ol class="captions stack">
      <li class="beat" data-beat="0 0.34">
        <p class="mono">El camino</p>
        <h2>De la puerta de la casa al altar</h2>
        <p class="text">Las flores de cempasúchil marcan el camino desde la entrada de la casa hasta la ofrenda.</p>
        <p class="mono source">Fuente: INAH</p>
      </li>
      <li class="beat" data-beat="0.34 0.76">
        <p class="mono">El color</p>
        <h2>Un pedazo de sol en el suelo</h2>
        <p class="text">Su amarillo se asocia con el sol, que guía el alma de los difuntos.</p>
        <p class="mono source">Fuente: Secretaría de Cultura</p>
      </li>
      <li class="beat" data-beat="0.76">
        <p class="mono">La llegada</p>
        <h2>Y las veladoras las reciben</h2>
        <p class="text">Las veladoras guían a las ánimas hasta la ofrenda.</p>
        <p class="mono source">Fuente: INAH</p>
      </li>
    </ol>
  </div>
</section>

<script>
  import { $ } from '../../scripts/dom';
  import { clamp, onProgress, onResize, reducedMotion } from '../../scripts/scenes';
  import { EDGE, LOOSE_PETALS, PETAL_CREASE, marigold } from '../../scripts/marigold';

  const scene = $('[data-scene="camino"]')!;
  const world = $('[data-world]', scene)!;
  const canvas = $<HTMLCanvasElement>('[data-fx]', scene)!;
  const guide = $<SVGPathElement>('[data-path]', scene)!;
  const ctx = canvas.getContext('2d')!;

  function random(seed: number) {
    return () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  // Timeline of the scene (in its scroll progress)
  const OPEN = 0.1; // the door has opened
  const ARRIVE = 0.8; // the path reaches the altar
  const FALL = 0.06; // how long one petal takes to fall

  const length = guide.getTotalLength();
  const pointAt = (u: number) => guide.getPointAtLength(clamp(u) * length);
  const front = (p: number) => clamp((p - OPEN) / (ARRIVE - OPEN));
  // Things near the viewer (lower on the ground) are drawn bigger
  const depth = (y: number) => 0.55 + 0.8 * clamp((y - 690) / 160);

  // Petals: each lands somewhere along the path, a little to either side
  const rand = random(1102);
  const PETALS = ['#f29a1c', '#ffb23f', '#e8780c', '#ffc35a', '#d9620b', '#f7a531'];
  const petals = Array.from({ length: 420 }, (_, i) => {
    const along = rand();
    const at = pointAt(along);
    const ahead = pointAt(along + 0.002);
    const angle = Math.atan2(ahead.y - at.y, ahead.x - at.x);
    const spread = (rand() - 0.5) * 2 * (8 + rand() * 22) * depth(at.y);
    const x = at.x - Math.sin(angle) * spread;
    const y = at.y + Math.cos(angle) * spread * 0.45;
    return {
      along,
      x,
      y,
      k: depth(y),
      size: 3.4 + rand() * 3.4,
      squash: 0.5 + rand() * 0.3,
      shape: i % LOOSE_PETALS.length,
      rot: rand() * Math.PI * 2,
      spin: (rand() - 0.5) * 10,
      flips: 1 + rand() * 3,
      drift: (rand() - 0.5) * 90,
      height: 160 + rand() * 300,
      color: PETALS[Math.floor(rand() * PETALS.length)],
    };
  }).sort((a, b) => a.y - b.y);

  // Whole marigold heads bloom at intervals along the path
  const blooms = Array.from({ length: 13 }, (_, i) => {
    const along = 0.04 + (i / 12) * 0.9;
    const at = pointAt(along);
    const side = i % 2 ? 1 : -1;
    return { along, x: at.x + side * (10 + rand() * 16) * depth(at.y), y: at.y + side * 6 * depth(at.y), k: depth(at.y), seed: rand() * 10, head: i % 9 };
  });

  // The same shapes as the flowers in the SVG, built once
  const petalShapes = LOOSE_PETALS.map((d) => new Path2D(d));
  const crease = new Path2D(PETAL_CREASE);
  const heads = [0, 1, 2].flatMap((shape) =>
    [0, 1, 2].map((tone) => marigold(shape, tone).map((l) => ({ ...l, path: new Path2D(l.d) }))),
  );

  function drawPetal(s: number, squash: number, color: string, shape: number) {
    // A loose petal: rounded heel, frilled tip, a little longer than it is wide
    const len = s * 2.1;
    ctx.scale(len, len * (0.85 + squash * 0.3));
    ctx.fillStyle = color;
    ctx.fill(petalShapes[shape]);
    ctx.lineWidth = 0.035;
    ctx.strokeStyle = 'rgba(120, 40, 0, 0.45)';
    ctx.stroke(petalShapes[shape]);
    ctx.lineWidth = 0.05;
    ctx.strokeStyle = 'rgba(150, 60, 0, 0.3)';
    ctx.stroke(crease);
  }

  function drawBloom(R: number, seed: number, head: number) {
    // Its shadow on the ground, then the flower head itself
    ctx.fillStyle = 'rgba(5, 3, 12, 0.35)';
    ctx.beginPath();
    ctx.ellipse(R * 0.15, R * 0.55, R * 1.05, R * 0.45, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.rotate(seed);
    ctx.scale(R, R);
    ctx.lineWidth = EDGE;
    ctx.lineJoin = 'round';
    for (const l of heads[head]) {
      ctx.globalAlpha = l.opacity ?? 1;
      ctx.fillStyle = l.fill;
      ctx.fill(l.path);
      if (l.stroke) {
        ctx.strokeStyle = l.stroke;
        ctx.stroke(l.path);
      }
    }
    ctx.globalAlpha = 1;
  }

  // Copal smoke: a soft sprite, reused by every particle
  const puff = document.createElement('canvas');
  puff.width = puff.height = 64;
  {
    const g = puff.getContext('2d')!;
    const grad = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    grad.addColorStop(0, 'rgba(236, 226, 248, 0.45)');
    grad.addColorStop(1, 'rgba(225, 215, 240, 0)');
    g.fillStyle = grad;
    g.fillRect(0, 0, 64, 64);
  }
  const smoke = Array.from({ length: 26 }, (_, i) => ({ phase: i / 26, wobble: rand() * 6, size: 0.7 + rand() * 0.6 }));

  // The canvas maps the same view box as the SVG
  const VB = JSON.parse(world.dataset.vb ?? '{"x":0,"y":0,"w":1600,"h":900}');
  let scale = 1;
  let dpr = 1;
  function measure() {
    const rect = world.getBoundingClientRect();
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = Math.round(rect.width * dpr);
    canvas.height = Math.round(rect.height * dpr);
    scale = rect.width / VB.w;
  }

  let p = 0;
  function draw(now: number) {
    // With reduced motion nothing moves on its own: the same scroll position always draws the same frame
    const time = reducedMotion ? 0 : now;
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.setTransform(dpr * scale, 0, 0, dpr * scale, -VB.x * dpr * scale, -VB.y * dpr * scale);

    const lead = front(p) * (1 + FALL);

    // Settled shadows first, so no petal is darkened by another's shadow
    ctx.fillStyle = 'rgba(5, 3, 12, 0.32)';
    for (const pt of petals) {
      if (lead - pt.along < FALL) continue;
      ctx.beginPath();
      ctx.ellipse(pt.x + 1.5 * pt.k, pt.y + 2 * pt.k, pt.size * pt.k * 1.1, pt.size * pt.k * 0.45, 0, 0, Math.PI * 2);
      ctx.fill();
    }

    for (const pt of petals) {
      const t = reducedMotion ? (lead >= pt.along ? 1 : 0) : clamp((lead - pt.along) / FALL);
      if (t <= 0) continue;
      const e = 1 - Math.pow(1 - t, 3);
      const x = pt.x + (1 - e) * pt.drift;
      const y = pt.y - (1 - e) * pt.height;
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(pt.rot + (1 - e) * pt.spin);
      // Tumbling in the air: the petal flips, and lies flat once it lands
      const flip = t < 1 ? Math.cos((1 - e) * pt.flips * Math.PI * 2) : 1;
      ctx.scale(pt.k, pt.k * (0.25 + 0.75 * Math.abs(flip)) * (t < 1 ? 1 : 0.72));
      ctx.globalAlpha = Math.min(1, t * 3);
      drawPetal(pt.size, pt.squash, pt.color, pt.shape);
      ctx.restore();
    }
    ctx.globalAlpha = 1;

    // Blooms pop open just after the petals around them land
    for (const b of blooms) {
      const t = reducedMotion ? (lead >= b.along + FALL ? 1 : 0) : clamp((lead - b.along - FALL * 0.6) / 0.03);
      if (t <= 0) continue;
      const pop = t < 1 ? 1 + Math.sin(t * Math.PI) * 0.25 : 1;
      ctx.save();
      ctx.translate(b.x, b.y);
      ctx.scale(b.k * pop * t, b.k * pop * t * 0.82);
      drawBloom(13, b.seed, b.head);
      ctx.restore();
    }

    // The soul: a small light that leaves the house and follows the path to the altar
    const glow = clamp((p - OPEN * 0.6) / 0.05) * (1 - clamp((p - ARRIVE - 0.04) / 0.05));
    if (glow > 0) {
      const u = front(p);
      ctx.globalCompositeOperation = 'lighter';
      for (let i = 12; i >= 0; i--) {
        const at = pointAt(u - i * 0.012);
        const k = depth(at.y);
        const wob = Math.sin(time * 0.003 + i) * 3;
        const a = glow * (1 - i / 13) * 0.5;
        const R = (i === 0 ? 26 : 10 - i * 0.5) * k;
        const lift = 42 * k + Math.sin(time * 0.002) * 5;
        const g = ctx.createRadialGradient(at.x, at.y - lift + wob, 0, at.x, at.y - lift + wob, R);
        g.addColorStop(0, `rgba(255, 244, 214, ${a})`);
        g.addColorStop(0.35, `rgba(255, 196, 110, ${a * 0.6})`);
        g.addColorStop(1, 'rgba(255, 150, 60, 0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(at.x, at.y - lift + wob, R, 0, Math.PI * 2);
        ctx.fill();
      }
      // Its light on the ground
      const at = pointAt(u);
      const g = ctx.createRadialGradient(at.x, at.y, 0, at.x, at.y, 90);
      g.addColorStop(0, `rgba(255, 190, 100, ${glow * 0.28})`);
      g.addColorStop(1, 'rgba(255, 190, 100, 0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.ellipse(at.x, at.y, 90, 34, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalCompositeOperation = 'source-over';
    }

    // Copal smoke rises once the altar is lit
    const smokeOn = clamp((p - ARRIVE) / 0.06);
    if (smokeOn > 0) {
      for (const s of smoke) {
        const age = reducedMotion ? s.phase : (s.phase + time * 0.00012) % 1;
        const y = 722 - age * 300;
        const x = 1300 + Math.sin(age * 5 + s.wobble) * (8 + age * 40);
        const size = (10 + age * 54) * s.size;
        ctx.globalAlpha = smokeOn * (1 - age) * Math.min(1, age * 6) * 0.28;
        ctx.drawImage(puff, x - size / 2, y - size / 2, size, size);
      }
      ctx.globalAlpha = 1;
    }
  }

  // A light loop runs only while the scene is on screen: the smoke and the soul's shimmer move with time
  let raf = 0;
  let visible = false;
  const loop = (time: number) => {
    draw(time);
    if (visible && !reducedMotion) raf = requestAnimationFrame(loop);
  };
  new IntersectionObserver(([entry]) => {
    visible = entry.isIntersecting;
    cancelAnimationFrame(raf);
    if (visible) raf = requestAnimationFrame(loop);
  }).observe(scene);

  measure();
  onResize(() => {
    measure();
    draw(performance.now());
  });
  onProgress(scene, (value) => {
    p = value;
    scene.style.setProperty('--lit', String(clamp((p - ARRIVE) / 0.12)));
    // Where the view is narrower than the field (phones), it follows the tip of the path
    scene.style.setProperty('--pan', ((pointAt(front(p)).x - 300) / 1000).toFixed(4));
    if (reducedMotion || !visible) draw(performance.now());
  });
</script>

<style>
  /* --lit is written by the script on the section, from the scene's progress */
  .camino {
    --lit: 0;
    --pan: 0;
  }
  .stage {
    background: #07051a;
    --open: clamp(0, (var(--p) - 0.02) / 0.08, 1);
  }

  /* A 16:9 box that covers the stage; where it is wider than the screen (phones),
     the view slides from the house to the altar as the path advances */
  .world {
    position: absolute;
    top: 50%;
    left: 0;
    width: max(100%, 100lvh * 16 / 9);
    aspect-ratio: 16 / 9;
    translate: 0 -50%;
    transform: translateX(calc((100vw - 100%) * clamp(0, var(--pan), 1)));
  }
  .art,
  .fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .part {
    inset: auto;
    overflow: visible;
  }
  .arch-layer {
    will-change: transform;
  }

  /* Night life */
  .stars circle {
    fill: #fff;
    animation: twinkle var(--d) ease-in-out var(--o) infinite alternate;
  }
  .town rect {
    fill: #ffcf7a;
    animation: twinkle var(--d) ease-in-out var(--o) infinite alternate;
  }
  @keyframes twinkle {
    from { opacity: 0.25; }
    to { opacity: 1; }
  }

  .pebbles ellipse {
    fill: #05030c;
  }
  .agave path {
    fill: #1d3a2c;
    stroke: #2c5640;
    stroke-width: 1;
  }
  .bricks path {
    fill: #6e3524;
    stroke: #4a2014;
    stroke-width: 1;
    opacity: 0.8;
  }

  /* The door swings inward on its left hinge; the house and the ground light up */
  .leaf {
    transform-box: fill-box;
    transform-origin: 0 50%;
    transform: scaleX(calc(1 - 0.82 * var(--open))) skewY(calc(var(--open) * -9deg));
  }
  .lit-in {
    opacity: var(--open);
  }
  .spill {
    opacity: var(--open);
  }
  .lantern-glass {
    opacity: calc(0.25 + 0.75 * var(--open));
  }
  .lantern-glow {
    opacity: var(--open);
  }

  .guide {
    fill: none;
    stroke: none;
  }

  /* Altar */
  .flag {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation: sway 3.2s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.45s);
  }
  @keyframes sway {
    from { rotate: -5deg; }
    to { rotate: 5deg; }
  }
  .veil {
    opacity: calc(1 - var(--lit));
  }
  .backlight {
    opacity: var(--lit);
  }
  .pool {
    opacity: calc(var(--lit) * 0.9);
  }
  .embers {
    opacity: calc(0.35 + 0.65 * var(--lit));
  }

  .candle {
    --on: clamp(0, (var(--p) - var(--at)) * 40, 1);
  }
  .flame,
  .halo {
    opacity: var(--on);
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .flame {
    scale: var(--on);
    animation: flicker 1.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.31s);
  }
  .halo {
    transform-origin: center;
    mix-blend-mode: screen;
    animation: breathe 2.2s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.5s);
  }
  @keyframes flicker {
    0% { transform: scaleY(1) skewX(0deg); }
    35% { transform: scaleY(1.14) skewX(3deg); }
    70% { transform: scaleY(0.9) skewX(-3deg); }
    100% { transform: scaleY(1.06) skewX(1deg); }
  }
  @keyframes breathe {
    from { transform: scale(0.92); }
    to { transform: scale(1.08); }
  }

  /* Captions sit in the sky, top left, clear of the path */
  .captions {
    position: absolute;
    left: var(--gutter);
    top: 96px;
    z-index: 1;
    list-style: none;
    padding: 0;
    max-width: 480px;
  }
  .captions .mono {
    color: var(--accent);
  }
  .captions .source {
    margin-top: 16px;
    color: var(--fg-dim);
  }
  h2 {
    margin-top: 12px;
    font-size: var(--t-4xl);
    line-height: 40px;
    text-shadow: 0 2px 16px rgb(7 5 26 / 0.8);
  }
  .text {
    margin-top: 12px;
    font-size: var(--t-xl);
    line-height: 28px;
    font-weight: 300;
    text-shadow: 0 1px 12px rgb(7 5 26 / 0.9);
  }

  @media (max-width: 767px) {
    h2 {
      font-size: var(--t-2xl);
      line-height: 32px;
    }
    .text {
      font-size: var(--t-base);
      line-height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars circle,
    .town rect,
    .flag,
    .flame,
    .halo {
      animation: none;
    }
  }
</style>
