---
/**
 * Papel picado: INAH says it adds color and represents the wind. The scroll
 * is the wind here: the further you go, the harder the flags and the letters sway.
 * All motion is computed in CSS from --p with sin().
 */

const flags = [
  { color: '#f29a1c', motif: 'flor' },
  { color: '#7b2d8e', motif: 'calavera' },
  { color: '#ffd27a', motif: 'flor' },
  { color: '#1f9e8a', motif: 'calavera' },
  { color: '#f29a1c', motif: 'flor' },
  { color: '#7b2d8e', motif: 'calavera' },
  { color: '#ffd27a', motif: 'flor' },
];

const word = 'el viento'.split('');
---

<section class="scene papel" data-scene="papel" data-theme="rosa" data-chapter="elementos" style="--len: 320">
  <div class="stage">
    <svg width="0" height="0" aria-hidden="true" class="defs">
      <defs>
        <mask id="cut-flor" maskContentUnits="objectBoundingBox">
          <rect width="1" height="1" fill="white" />
          <path fill="black" d="M0 0.86 Q0.0625 0.78 0.125 0.86 T0.25 0.86 T0.375 0.86 T0.5 0.86 T0.625 0.86 T0.75 0.86 T0.875 0.86 T1 0.86 V1 H0Z" />
          <circle cx="0.5" cy="0.42" r="0.07" fill="black" />
          {[0, 1, 2, 3, 4, 5, 6, 7].map((k) => {
            const a = (k / 8) * Math.PI * 2;
            return <ellipse cx={(0.5 + Math.cos(a) * 0.2).toFixed(3)} cy={(0.42 + Math.sin(a) * 0.16).toFixed(3)} rx="0.06" ry="0.05" fill="black" />;
          })}
          {[0.12, 0.88].map((x) => <circle cx={x} cy="0.12" r="0.04" fill="black" />)}
          {[0.15, 0.85].map((x) => <path fill="black" d={`M${x} 0.6 l0.05 0.06 l-0.05 0.06 l-0.05 -0.06Z`} />)}
        </mask>
        <mask id="cut-calavera" maskContentUnits="objectBoundingBox">
          <rect width="1" height="1" fill="white" />
          <path fill="black" d="M0 0.86 Q0.0625 0.78 0.125 0.86 T0.25 0.86 T0.375 0.86 T0.5 0.86 T0.625 0.86 T0.75 0.86 T0.875 0.86 T1 0.86 V1 H0Z" />
          <circle cx="0.4" cy="0.38" r="0.07" fill="black" />
          <circle cx="0.6" cy="0.38" r="0.07" fill="black" />
          <path fill="black" d="M0.5 0.47 l0.035 0.07 h-0.07Z" />
          {[0.38, 0.44, 0.5, 0.56, 0.62].map((x) => <rect x={x - 0.018} y="0.6" width="0.036" height="0.06" fill="black" />)}
          {[0.12, 0.88].map((x) => <circle cx={x} cy="0.12" r="0.04" fill="black" />)}
          {[0.15, 0.85].map((x) => <circle cx={x} cy="0.66" r="0.035" fill="black" />)}
        </mask>
      </defs>
    </svg>

    <div class="garland" aria-hidden="true">
      <span class="string"></span>
      {
        flags.map((f, i) => (
          <svg class="flag" viewBox="0 0 100 120" style={`--i: ${i}`}>
            <rect width="100" height="120" fill={f.color} mask={`url(#cut-${f.motif})`} />
          </svg>
        ))
      }
    </div>

    <p class="wind" aria-hidden="true">
      {word.map((ch, i) => <span style={`--i: ${i}`}>{ch === ' ' ? ' ' : ch}</span>)}
    </p>

    <div class="caption">
      <h2 class="sr-only">El viento</h2>
      <p class="text">El papel picado da color a la ofrenda y representa el viento.</p>
      <p class="mono source">Fuente: INAH, «Ofrendas para los muertos»</p>
    </div>
  </div>
</section>

<style>
  .defs {
    position: absolute;
  }

  .stage {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 0 var(--gutter) calc(64px + var(--chrome));
  }

  /* Wind grows with the scroll */
  .stage {
    --wind: calc(3deg + var(--p) * 14deg);
  }

  .garland {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter);
    margin-top: 72px;
  }
  .string {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: color-mix(in srgb, var(--fg) 60%, transparent);
  }
  .flag {
    width: min(13vw, 160px);
    height: auto;
    transform-origin: 50% 0;
    rotate: calc(sin(var(--p) * 22rad + var(--i) * 1.3rad) * var(--wind));
    transform: perspective(600px) rotateX(calc(sin(var(--p) * 17rad + var(--i) * 0.9rad) * var(--wind) * 1.4));
    filter: drop-shadow(0 8px 12px rgb(60 0 25 / 0.25));
  }

  .wind {
    align-self: center;
    justify-self: center;
    font-size: var(--t-8xl);
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .wind span {
    display: inline-block;
    rotate: calc(sin(var(--p) * 14rad + var(--i) * 0.8rad) * var(--wind) * 1.2);
    translate: 0 calc(sin(var(--p) * 11rad + var(--i) * 1.1rad) * var(--p) * 24px);
  }

  .caption {
    max-width: 560px;
  }
  .text {
    font-size: var(--t-2xl);
    line-height: 32px;
    font-weight: 300;
  }
  .source {
    margin-top: 16px;
    color: var(--fg-dim);
  }

  @media (min-width: 1280px) {
    .wind {
      font-size: var(--t-9xl);
      scale: 1.4;
    }
  }
  @media (max-width: 767px) {
    .wind {
      font-size: var(--t-6xl);
    }
    .text {
      font-size: var(--t-xl);
      line-height: 28px;
    }
  }
</style>
