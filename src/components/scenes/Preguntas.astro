---
import { strings } from '../../i18n';
/**
 * Questions people ask about the altar, answered from the same sources.
 * A plain reading section: no sticky stage, the answers open in place.
 */

const t = strings(Astro.currentLocale).preguntas;
const faqs = t.faqs;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: Astro.currentLocale ?? 'es',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="flow preguntas" id="preguntas" data-scene="preguntas" data-theme="noche" data-chapter="preguntas">
  <div class="inner">
    <header>
      <p class="mono kicker">{t.kicker}</p>
      <h2>{t.title}</h2>
    </header>

    <div class="list">
      {
        faqs.map((f) => (
          <details>
            <summary>
              <span>{f.q}</span>
              <svg viewBox="0 0 256 256" aria-hidden="true">
                <path fill="currentColor" d="M224,128a8,8,0,0,1-8,8H136v80a8,8,0,0,1-16,0V136H40a8,8,0,0,1,0-16h80V40a8,8,0,0,1,16,0v80h80A8,8,0,0,1,224,128Z" />
              </svg>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<script>
  import { $$ } from '../../scripts/dom';

  // Rows fade up as they enter the viewport
  const rows = $$('.preguntas header, .preguntas details');
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        io.unobserve(entry.target);
      }
    },
    { rootMargin: '0px 0px -10% 0px' },
  );
  rows.forEach((row, i) => {
    (row as HTMLElement).style.transitionDelay = `${Math.min(i, 6) * 60}ms`;
    io.observe(row);
  });
</script>

<style>
  .preguntas {
    position: relative;
    padding: 96px var(--gutter);
  }

  .inner {
    display: grid;
    gap: 48px;
    max-width: 1120px;
    margin: 0 auto;
  }

  .kicker {
    color: var(--accent);
  }

  h2 {
    margin-top: 12px;
    max-width: 680px;
    font-size: var(--t-5xl);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .list {
    display: grid;
  }

  details {
    border-radius: 16px;
    transition: background-color 500ms var(--ease);
  }
  details:hover {
    background: color-mix(in srgb, var(--fg) 4%, transparent);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 16px;
    font-size: var(--t-2xl);
    line-height: 32px;
    font-weight: 300;
    cursor: pointer;
    list-style: none;
    box-shadow: 0 1px 0 color-mix(in srgb, var(--fg) 14%, transparent);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary svg {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--accent);
    transition: transform 600ms var(--ease);
  }
  details[open] summary svg {
    transform: rotate(45deg);
  }
  summary:active {
    transform: translateY(1px);
  }

  details p {
    max-width: 720px;
    padding: 16px 16px 24px;
    font-size: var(--t-lg);
    line-height: 28px;
    color: color-mix(in srgb, var(--fg) 80%, transparent);
  }

  /* Opening animates its height where the browser supports it */
  @supports (interpolate-size: allow-keywords) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 700ms var(--ease),
        content-visibility 700ms allow-discrete;
    }
    details[open]::details-content {
      block-size: auto;
    }
  }

  /* Scroll reveal */
  .js .preguntas header,
  .js .preguntas details {
    opacity: 0;
    filter: blur(12px);
    transform: translateY(64px);
    transition:
      opacity 900ms var(--ease),
      filter 900ms var(--ease),
      transform 900ms var(--ease),
      background-color 500ms var(--ease);
  }
  .js .preguntas .is-in {
    opacity: 1;
    filter: none;
    transform: none;
  }

  @media (min-width: 900px) {
    .inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }
    header {
      position: sticky;
      top: 96px;
    }
  }
  @media (max-width: 767px) {
    h2 {
      font-size: var(--t-4xl);
      line-height: 40px;
    }
    summary {
      font-size: var(--t-xl);
      line-height: 28px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .preguntas header,
    .js .preguntas details {
      transform: none;
      filter: none;
    }
  }
</style>
