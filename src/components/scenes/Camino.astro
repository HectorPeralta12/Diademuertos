            {[396, 412, 428, 444, 460].map((x) => <rect x={x - 2} y="454" width="4" height="80" fill="#1a1412" />)}
            <rect x="380" y="490" width="88" height="4" fill="#1a1412" />
            <rect x="366" y="540" width="116" height="10" rx="2" fill="#b9a585" />
            <!-- Pot of marigolds on the sill -->
            <path d="M414 518 q -6 -6 -10 -14 q 8 2 12 10 z M440 518 q 6 -6 12 -12 q -8 0 -14 8 z" fill="#2f5a2a" />
            {sillPot.map((m) => <use href={m.v} x={m.x} y={m.y} width={m.r} height={m.r} transform={`rotate(${m.rot} ${m.x + m.r / 2} ${m.y + m.r / 2})`} />)}
            <path d="M406 540 l3 -22 h30 l3 22 z" fill="url(#cm-clay)" />
            <rect x="404" y="514" width="40" height="6" rx="2" fill="#a0532c" />
