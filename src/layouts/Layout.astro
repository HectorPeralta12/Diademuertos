---
import { Font } from 'astro:assets';

const title = 'Día de Muertos · La ofrenda';
const description =
  'Recorre una ofrenda de Día de Muertos nivel por nivel: qué significa cada elemento, de dónde vienen sus fechas y por qué el cempasúchil marca el camino. Con información del INAH y la UNESCO.';

const chapters = [
  { id: 'ofrenda', label: 'Ofrenda' },
  { id: 'elementos', label: 'Elementos' },
  { id: 'historia', label: 'Historia' },
  { id: 'preguntas', label: 'Preguntas' },
];
---

<!doctype html>
<html lang="es" data-theme="noche">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#100c1f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/xolo-hero.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href="/images/xolo-hero.webp" />
    <Font cssVariable="--font-jost" preload={[{ weight: '300 600', style: 'normal' }]} />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body>
    <a class="skip mono" href="#contenido">Saltar al contenido</a>

    <header class="chrome">
      <a class="brand mono" href="#inicio">Día de Muertos</a>
      <nav aria-label="Capítulos">
        {
          chapters.map((c) => (
            <a class="mono" href={`#${c.id}`} data-chapter-link={c.id}>
              {c.label}
            </a>
          ))
        }
      </nav>
    </header>

    <slot />

  </body>
</html>

<style is:global>
  :root {
    /* Materials of the story */
    --noche: #100c1f;
    --cera: #f3ece0;
    --humo: #9d93b5;
    --amate: #ece3d2;
    --tinta: #23190f;
    --cempasuchil: #f29a1c;
    --morado: #34174a;
    --rosa: #c2185b;
    --copal: #24130b;

    --font-sans: var(--font-jost);
    --font-mono: var(--font-geist-mono);

    /* Type scale (Tailwind steps) */
    --t-xs: 0.75rem;
    --t-sm: 0.875rem;
    --t-base: 1rem;
    --t-lg: 1.125rem;
    --t-xl: 1.25rem;
    --t-2xl: 1.5rem;
    --t-3xl: 1.875rem;
    --t-4xl: 2.25rem;
    --t-5xl: 3rem;
    --t-6xl: 3.75rem;
    --t-7xl: 4.5rem;
    --t-8xl: 6rem;
    --t-9xl: 8rem;

    --gutter: 24px;
    --chrome: 0px;
    --ease: cubic-bezier(0.32, 0.72, 0, 1);

    --bg: var(--noche);
    --fg: var(--cera);
    --fg-dim: var(--humo);
    --accent: var(--cempasuchil);
  }

  @media (min-width: 768px) {
    :root { --gutter: 48px; }
  }
  @media (min-width: 1280px) {
    :root { --gutter: 64px; }
  }

  html[data-theme='amate'] {
    --bg: var(--amate);
    --fg: var(--tinta);
    --fg-dim: #75654f;
    --accent: #b5420f;
  }
  html[data-theme='cempasuchil'] {
    --bg: var(--cempasuchil);
    --fg: #1d1104;
    --fg-dim: #6d4108;
    --accent: #1d1104;
  }
  html[data-theme='morado'] {
    --bg: var(--morado);
    --fg: #f5e9f6;
    --fg-dim: #c3a2cf;
    --accent: var(--cempasuchil);
  }
  html[data-theme='rosa'] {
    --bg: var(--rosa);
    --fg: #fff1f6;
    --fg-dim: #f7b8cf;
    --accent: #ffd27a;
  }
  html[data-theme='copal'] {
    --bg: var(--copal);
    --fg: #f2dcc8;
    --fg-dim: #b98a68;
    --accent: var(--cempasuchil);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    background-color: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: var(--t-lg);
    line-height: 1.55;
    font-weight: 400;
    /* Only the background fades: fading color would restyle the page every frame */
    transition: background-color 900ms var(--ease);
    -webkit-font-smoothing: antialiased;
  }

  img,
  svg,
  video {
    display: block;
    max-width: 100%;
  }

  h1, h2, h3, p, figure, blockquote, ol, ul, dl, dd {
    margin: 0;
  }

  h1, h2, h3 {
    font-weight: 300;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  a {
    color: inherit;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 100;
    padding: 8px 12px;
    border-radius: 9999px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 400ms var(--ease);
  }
  .skip:focus-visible {
    transform: none;
  }

  /* Chrome: brand and chapters, quiet so the scenes carry the page */
  .chrome {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 24px var(--gutter);
    pointer-events: none;
  }
  .chrome a {
    pointer-events: auto;
    text-decoration: none;
    color: var(--fg);
    text-shadow: 0 0 12px rgb(0 0 0 / 0.3);
    transition: opacity 400ms var(--ease), color 900ms var(--ease);
  }
  .chrome nav {
    display: flex;
    gap: 4px;
  }
  .chrome nav a {
    padding: 8px 12px;
    border-radius: 9999px;
    opacity: 0.55;
  }
  .chrome nav a:hover,
  .chrome nav a[aria-current] {
    opacity: 1;
  }
  .chrome nav a[aria-current] {
    box-shadow: inset 0 0 0 1px currentColor;
  }
  @media (max-width: 767px) {
    .chrome nav a:not([aria-current]) {
      display: none;
    }
  }


  /* Scene: a tall container with a sticky stage */
  .scene {
    position: relative;
    height: calc(var(--len, 300) * 1vh);
  }

  .js .scene {
    content-visibility: auto;
  }
  .scenes-ready .scene:not(.is-far) {
    content-visibility: visible;
  }

  @supports (height: 1svh) {
    :root {
      --chrome: calc(100lvh - 100svh);
    }
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
  }

  .js .scene {
    --p: 0;
  }

  /* Texts that light up at their moment, stacked in the same cell */
  .js .stack {
    display: grid;
  }
  .js .stack > * {
    grid-area: 1 / 1;
  }
  .js .beat {
    opacity: 0;
    visibility: hidden;
    filter: blur(8px);
    transform: translateY(16px);
    transition:
      opacity 600ms var(--ease),
      filter 600ms var(--ease),
      transform 800ms var(--ease),
      visibility 0s linear 600ms;
  }
  .js .beat.is-on {
    opacity: 1;
    visibility: visible;
    filter: none;
    transform: none;
    transition:
      opacity 800ms var(--ease) 100ms,
      filter 800ms var(--ease) 100ms,
      transform 900ms var(--ease) 100ms,
      visibility 0s;
  }

  /* Full screen layers that appear at --a and disappear at --b */
  .layer {
    position: absolute;
    inset: 0;
    opacity: calc(
      clamp(0, calc((var(--p, 1) - var(--a, -1)) / var(--fade, 0.025)), 1) *
        (1 - clamp(0, calc((var(--p, 1) - var(--b, 2)) / var(--fade, 0.025)), 1))
    );
  }

  .still {
    --p: 0;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: var(--t-base);
    line-height: 24px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 500ms var(--ease),
      background-color 500ms var(--ease),
      box-shadow 500ms var(--ease);
  }
  .btn svg {
    width: 16px;
    height: 16px;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn:active {
    transform: scale(0.98);
  }
  .btn--primary {
    background: var(--fg);
    color: var(--bg);
  }
  .btn--ghost {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 35%, transparent);
  }
  .btn--ghost:hover {
    box-shadow: inset 0 0 0 1px var(--fg);
  }

  /* Without JavaScript the story reads from top to bottom */
  html:not(.js) .scene {
    height: auto;
  }
  html:not(.js) .stage {
    position: relative;
    height: auto;
    min-height: 100vh;
    padding-block: 96px;
  }

  @media (prefers-reduced-motion: reduce) {
    .js .beat,
    .js .beat.is-on {
      transition: opacity 200ms linear, visibility 0s;
      transform: none;
      filter: none;
    }
  }
</style>
