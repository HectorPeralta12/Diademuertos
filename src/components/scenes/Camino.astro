                <path d={`M${x - 6} 608 q -8 -4 -12 -12 q 9 1 14 9 z M${x + 6} 608 q 8 -4 13 -11 q -9 0 -15 8 z`} fill="#2f5a2a" />
                {potFlowers[k].map((m) => <use href={m.v} x={m.x} y={m.y} width={m.r} height={m.r} transform={`rotate(${m.rot} ${m.x + m.r / 2} ${m.y + m.r / 2})`} />)}
                <path d={`M${x - 14} 632 l 4 -22 h 20 l 4 22 z`} fill="url(#cm-clay)" />
                <rect x={x - 16} y="606" width="32" height="5" rx="2" fill="#a0532c" />
