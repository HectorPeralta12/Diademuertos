        <!-- Light spilling from the door across the ground -->
        <path class="spill" d="M262 706 L 338 706 L 700 900 L 20 900 Z" fill="url(#cm-spill)" filter="url(#cm-soft)" />

        <path d={PATH} class="guide" data-path />

        <!-- The altar -->
        <g class="altar">
          <ellipse class="backlight" cx="1300" cy="520" rx="320" ry="300" fill="url(#cm-warm)" />
          <ellipse class="pool" cx="1300" cy="770" rx="340" ry="70" fill="url(#cm-warm)" />
          <ellipse cx="1300" cy="744" rx="230" ry="16" fill="#000" opacity="0.45" />

          <!-- Papel picado garland, tied to the shoulders of the arch -->
          <path d={cordPath(altarCord)} fill="none" stroke="#d9c7a8" stroke-width="1.5" opacity="0.7" />
          {
            flags.map((fl) => (
              <g transform={`translate(${fl.x} ${fl.y}) rotate(${fl.angle})`}>
                <g class="flag" style={`--i: ${fl.i}`}>
                  <rect x="-13" y="-1.5" width="26" height="33.5" fill={fl.c} mask="url(#cm-cut)" />
